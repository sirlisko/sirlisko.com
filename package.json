		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@shikijs/transformers": "^4.5.0",
		"astro": "^7.3.5",
		"leaflet": "^1.9.4",
		"leaflet-gameboy": "^0.1.0",
		"leaflet-gpx": "1.7.0",
		"lucide": "^1.52.0",
