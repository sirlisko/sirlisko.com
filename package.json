{
	"name": "sirlisko.com",
	"private": true,
	"type": "module",
	"description": "Personal Website of Luca Lischetti",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirlisko/sirlisko.com.git"
	},
	"author": {
		"name": "Luca Lischetti",
		"email": "luca@sirlisko.com",
		"url": "https://sirlisko.com"
	},
	"homepage": "https://sirlisko.com",
	"keywords": [
		"sirlisko",
		"personal",
		"website"
	],
	"license": "MIT",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build && pagefind --site dist --output-subdir blog/pagefind",
		"preview": "astro preview",
		"astro": "astro",
		"check": "biome check --write .",
		"test": "vitest",
		"typecheck": "astro sync && tsc --noEmit",
		"generate:cv": "node scripts/generate-cv.mjs",
		"capture:screenshots": "node scripts/capture-screenshots.mjs",
		"generate:og": "node scripts/generate-og.mjs",
		"generate:feed-images": "node scripts/generate-feed-images.mjs",
		"images": "node scripts/optimize-images.mjs",
		"gpx": "node scripts/simplify-gpx.mjs",
		"lighthouse": "node scripts/lighthouse.mjs",
		"a11y": "node scripts/a11y.mjs",
		"gsc": "node scripts/gsc-index-status.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@shikijs/transformers": "^4.5.0",
		"astro": "^7.4.2",
		"astro-pele": "0.1.1",
		"leaflet": "^1.9.4",
		"leaflet-gameboy": "^0.1.0",
		"leaflet-gpx": "2.2.0",
		"lucide": "^1.61.0",
		"pele": "1.12.0",
		"rehype-callouts": "^2.2.0",
		"sanitize-html": "^2.18.1",
		"satori": "0.63.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@pagefind/default-ui": "^1.5.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/leaflet": "^1.9.22",
		"@types/sanitize-html": "^2.16.2",
		"jsdom": "^30.1.3",
		"pagefind": "^1.5.2",
		"pdf-lib": "^1.17.1",
		"puppeteer": "^25.16.0",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.11.2"
