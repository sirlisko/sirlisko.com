---
import me from "../../data/me";
import {
	NPMPackages,
	pastProjects,
	projects,
	tinyProjects,
} from "../../data/projects";
import FaceLink from "../components/FaceLink.astro";
import Links from "../components/Links.astro";
import Section from "../components/projects/Section.astro";
import { AUTHOR, ogCard } from "../config";
import Layout from "../layouts/Layout.astro";
---

<Layout
	{...ogCard("projects")}
	title="Projects"
	description="Side projects by Luca Lischetti (sirlisko): web apps, tiny single-purpose sites, npm packages, and retired Chrome extensions and experiments."
	theme="dark"
	themeColor="#000"
>
	<header>
		<Links page="projects" />
		<FaceLink />
	</header>
	<main id="main-content" class="cart">
		<header>
			<h1>Projects</h1>
			<p>Every side project on one cartridge.</p>
		</header>

		<Section title="Live" projects={projects} big />
		<Section title="Tiny tools" projects={tinyProjects} />
		<Section title="npm packages" projects={NPMPackages} />
		<Section title="Out of order" projects={pastProjects} retired />

		<footer class="start">
			<a class="p2" href={`mailto:${me.email}`}>Player 2, press start</a>
			<p>
				Got an idea, or a project you want to talk through? Write to{" "}
				<a href={`mailto:${me.email}`}>{me.email}</a>.
			</p>
			<p>
				Older experiments live on{" "}
				<a
					href={AUTHOR.profiles.GitHub}
					target="_blank"
					rel="noopener noreferrer"
					>GitHub</a
				>.
			</p>
			<p>How this site is made: <a href="/credits">credits</a>.</p>
		</footer>
	</main>
</Layout>

<style>
.cart {
	max-width: 1080px;
	margin: 0 auto;
	font-family: var(--font-mono);
	font-size: 16px;
	color: var(--nes-white);
}

main > header {
	text-align: center;
	margin: 0 0 4rem;

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(32px, 8vw, 64px);
		line-height: 1.2;
		color: var(--nes-yellow);
		text-shadow:
			4px 4px 0 var(--nes-orange),
			8px 8px 0 var(--nes-red);
	}

	p {
		margin: 1.75rem 0 0;
		color: var(--nes-silver);
	}
}

.start {
	margin: 4rem 0 0;
	text-align: center;

	p {
		margin: 1.25rem 0 0;
		font-size: 15px;
		color: var(--nes-silver);
	}

	p a {
		color: var(--nes-yellow);

		&:hover {
			text-decoration: none;
		}
	}

	.p2 {
		font-family: var(--font-display);
		font-size: 16px;
		line-height: 1.5;
		color: var(--nes-white);
		text-decoration: none;
		animation: blink 1.2s step-end infinite;

		&:hover,
		&:focus-visible {
			color: var(--nes-yellow);
			animation: none;
		}

		&:focus-visible {
			outline: 2px solid var(--nes-yellow);
			outline-offset: 3px;
		}
	}
}
</style>
