---
import {
	ArrowBigRight,
	Chrome,
	Github,
	Rss,
	SquareArrowOutUpRight,
} from "lucide-react";
import { pastProjects, projects } from "../../data/projects";
import Links from "../components/Links.astro";
import Layout from "../layouts/Layout.astro";

const isNpmModule = (p: (typeof projects)[0]) => p.tech.includes("NPM Module");
const activeProjects = projects.filter(
	(p) => !p.isDeprecated && !isNpmModule(p),
);
const npmModules = projects.filter(isNpmModule);

function primaryLink(links: Record<string, string>) {
	const entry = Object.entries(links).find(
		([k]) => k !== "Github" && k !== "Screenshot",
	);
	return entry ? entry[1] : null;
}
---

<Layout
	title="Projects"
	description="Discover a diverse range of projects by Luca Lischetti, aka sirlisko. Explore creations like GigPlayList, ZoomMEME, Shazamify, and more, showcasing a fusion of creativity and technical expertise in web apps, npm modules, Chrome extensions, and Alexa skills."
	keywords={[
    "Luca Lischetti",
    "sirlisko",
    "web developer",
    "software engineer",
    "projects",
    "ideas",
  ]}
>
	<Links page="projects" inverted />
	<main class="page">
		<a href="/" class="face-link">
			<img
				src="/images/me.webp"
				alt="sirlisko face"
				width={60}
				height={86}
				transition:name="face"
			>
		</a>

		<header>
			<p class="eyebrow">// things I've built</p>
			<h1>Projects<span class="cursor"></span></h1>
			<p class="subtitle">Side projects, tools, experiments.</p>
			<p class="subtitle">Some still alive, some honourably retired.</p>
		</header>

		<div class="s-active">
			<p class="bp-title">Active</p>

			<div class="bp-list">
				{activeProjects.map((p) => {
					const live = primaryLink(p.links);
					return (
						<div class="bp-card">
							<div class="bp-card-body">
								<div class="bp-card-header">
									<div class="bp-card-name-wrap">
										{"logo" in p ? (
											<img
												class={`bp-icon${p.invertIcon ? " inverted" : ""}`}
												src={p.logo}
												alt={`${p.title} logo`}
												width={20}
												height={20}
											/>
										) : (
											<span class="bp-icon bp-icon--svg">
												<p.icon size={20} />
											</span>
										)}
										<p class="entry-name">{p.title}</p>
									</div>
									<div class="bp-card-links">
										{live && (
											<a href={live} target="_blank" rel="noopener noreferrer" aria-label="Live demo">
												<SquareArrowOutUpRight size={20} />
											</a>
										)}
										{p.links.Github && (
											<a href={p.links.Github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
												<Github size={20} />
											</a>
										)}
									</div>
								</div>
								<p class="entry-desc">{p.description[0]}</p>
								<div class="tags">
									{p.tech.map((t) => (
										<span class="tag">{t}</span>
									))}
								</div>
							</div>
						</div>
					);
				})}
			</div>

			<p class="bp-divider">NPM Packages</p>

			<div class="npm-list">
				{npmModules.map((p) => (
					<div class="npm-row">
						<div class="npm-body">
							<div class="npm-header">
								<div class="npm-name-wrap">
									{"logo" in p ? (
										<img class="npm-icon" src={p.logo} alt="" width={20} height={20} />
									) : (
										<span class="npm-icon npm-icon--svg">
											<p.icon size={20} />
										</span>
									)}
									<p class="entry-name">{p.title}</p>
								</div>
								<div class="npm-links">
									{p.links["NPM Module"] && (
										<a href={p.links["NPM Module"]} target="_blank" rel="noopener noreferrer">
											<SquareArrowOutUpRight size={20} />
										</a>
									)}
									{p.links.Github && (
										<a href={p.links.Github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
											<Github size={20} />
										</a>
									)}
								</div>
							</div>
							<p class="entry-desc">{p.description[0]}</p>
							<div class="tags">
								{p.tech.filter((t) => t !== "NPM Module").map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<div class="s-deprecated">
			<div class="term-bar">
				<span class="dot r"></span>
				<span class="dot y"></span>
				<span class="dot g"></span>
				<span class="term-bar-title">luca@sirlisko — git log --retired</span>
			</div>
			<div class="term-body">
				<p class="dep-intro"># these served their time</p>
				{pastProjects.map((p) => (
					<div class="dep-entry">
						<div class="dep-head">
							<span class="dep-prompt">❯</span>
							<div class="dep-name-wrap">
								{"logo" in p ? (
									<img
										class={`dep-icon${p.invertIcon ? " inverted" : ""}`}
										src={p.logo}
										alt=""
										width={20}
										height={20}
									/>
								) : (
									<span class="dep-icon dep-icon--svg">
										<p.icon size={20} />
									</span>
								)}
								<span class="entry-name">{p.title}</span>
								<span class="dep-badge">deprecated</span>
							</div>
							<div class="dep-links">
								{Object.entries(p.links)
									.filter(([k]) => k !== "Screenshot")
									.map(([label, url]) => (
										<a href={url} target="_blank" rel="noopener noreferrer" aria-label={label}>
											{label === "Github" ? (
												<Github size={20} />
											) : label === "Blog" ? (
												<Rss size={20} />
											) : label === "Chrome extension" ? (
												<Chrome size={20} />
											) : (
												label.toLowerCase()
											)}
										</a>
									))}
							</div>
						</div>
						<p class="entry-desc">{p.description[0]}</p>
						<div class="tags">
							{p.tech.map((t) => (
								<span class="tag">{t}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>

		<footer>
			<span
				>More on{' '}
				<a
					href="https://github.com/sirlisko"
					target="_blank"
					rel="noopener noreferrer"
					>github</a
				></span
			>
			<span><a href="/resume">resume</a> <ArrowBigRight size={14} /></span>
		</footer>
	</main>
</Layout>

<style>
body {
	background: var(--bg);
	color: var(--text);
}

.page {
	max-width: 720px;
	margin: 0 auto;
	padding-top: 5rem;
}

.face-link {
	margin-bottom: 2rem;
}

header {
	margin-bottom: 3rem;
	animation: fadeUp 0.4s ease both;
}

.eyebrow {
	font-family: var(--font-display);
	font-size: 9px;
	color: var(--yellow);
	letter-spacing: 0.15em;
	text-transform: uppercase;
	margin-bottom: 1rem;
}

h1 {
	font-family: var(--font-display);
	font-size: clamp(22px, 5vw, 34px);
	color: var(--white);
	line-height: 1.4;
	margin-bottom: 0.75rem;
}

.cursor {
	display: inline-block;
	width: 10px;
	height: 1em;
	background: var(--yellow);
	vertical-align: middle;
	animation: blink 1s step-end infinite;
	margin-left: 4px;
}

.subtitle {
	color: var(--muted);
	font-size: 13px;
	font-style: italic;
}

.s-active {
	margin-bottom: 3.5rem;
	animation: fadeUp 0.4s ease 0.06s both;
	background: #04090f;
	border: 1px solid #0a1a30;
	padding: 1.75rem;
	position: relative;
	overflow: hidden;

	.entry-name {
		color: rgba(var(--blue-rgb), 0.95);
	}

	.entry-desc {
		color: rgba(var(--blue-rgb), 0.7);
	}

	.tag {
		border: 1px solid rgba(var(--blue-rgb), 0.35);
		color: rgba(var(--blue-rgb), 0.7);
	}

	/* grid lines */
	&::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(var(--blue-rgb), 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--blue-rgb), 0.035) 1px, transparent 1px);
		background-size: 22px 22px;
		pointer-events: none;
	}

	/* corner brackets */
	&::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			top left / 14px 1px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			top left / 1px 14px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			top right / 14px 1px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			top right / 1px 14px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			bottom right / 14px 1px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			bottom right / 1px 14px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			bottom left / 14px 1px,
			linear-gradient(rgba(var(--blue-rgb), 0.35), rgba(var(--blue-rgb), 0.35))
			bottom left / 1px 14px;
		background-repeat: no-repeat;
		pointer-events: none;
	}
}

.bp-title {
	font-family: var(--font-display);
	font-size: 9px;
	color: rgba(var(--blue-rgb), 0.6);
	letter-spacing: 0.2em;
	text-transform: uppercase;
	margin-bottom: 1.5rem;
	display: flex;
	align-items: center;
	gap: 0.75rem;

	&::after {
		content: "";
		flex: 1;
		height: 1px;
		background: rgba(var(--blue-rgb), 0.1);
	}
}

.bp-list {
	display: flex;
	flex-direction: column;
	margin-bottom: 2rem;
}

.bp-card {
	padding: 1.1rem 0;
	border-bottom: 1px solid rgba(var(--blue-rgb), 0.07);

	&:first-child {
		border-top: 1px solid rgba(var(--blue-rgb), 0.07);
	}
}

.bp-card-body {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
	min-width: 0;
}

.bp-card-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	flex-wrap: wrap;
	margin-bottom: 0.2rem;
}

.bp-card-name-wrap {
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.bp-icon,
.npm-icon,
.dep-icon {
	width: 20px;
	height: 20px;
	object-fit: contain;
	flex-shrink: 0;
	opacity: var(--icon-opacity, 0.7);
	mix-blend-mode: screen;

	&.inverted {
		mix-blend-mode: normal;
		filter: invert(1) opacity(var(--icon-opacity, 0.7));
	}
}
.npm-icon {
	--icon-opacity: 0.6;
}
.dep-icon {
	--icon-opacity: 0.4;
}

.bp-icon--svg {
	display: flex;
	align-items: center;
	justify-content: center;
	color: rgba(var(--blue-rgb), 0.7);
	width: 16px;
	height: 16px;
	flex-shrink: 0;
}

.entry-name {
	font-size: 13px;
	letter-spacing: 0.05em;
}

.entry-desc {
	font-size: 13px;
	line-height: 1.7;
}

.tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.3rem;
}

.tag {
	font-family: var(--font-display);
	font-size: 9px;
	padding: 3px 7px;
	letter-spacing: 0.05em;
}

.bp-card-links {
	display: flex;
	gap: 0.75rem;
	flex-shrink: 0;
	align-items: center;

	a {
		font-size: 11px;
		color: rgba(var(--blue-rgb), 0.65);
		text-decoration: none;
		transition: color 0.15s;
		white-space: nowrap;
		display: flex;
		align-items: center;

		&:hover {
			color: var(--blue);
		}
	}
}

.bp-divider {
	font-family: var(--font-display);
	font-size: 9px;
	color: rgba(var(--blue-rgb), 0.4);
	letter-spacing: 0.15em;
	text-transform: uppercase;
	margin-bottom: 0.5rem;
	display: flex;
	align-items: center;
	gap: 0.75rem;

	&::before {
		content: "//";
		color: rgba(var(--blue-rgb), 0.2);
	}

	&::after {
		content: "";
		flex: 1;
		height: 1px;
		background: rgba(var(--blue-rgb), 0.07);
	}
}

.npm-list {
	display: flex;
	flex-direction: column;
}

.npm-row {
	padding: 0.8rem 0;
	border-bottom: 1px solid rgba(var(--blue-rgb), 0.06);

	&:last-child {
		border-bottom: none;
	}
}

.npm-body {
	display: flex;
	flex-direction: column;
	gap: 0.4rem;
}

.npm-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	margin-bottom: 0.2rem;
}

.npm-name-wrap {
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.npm-icon--svg {
	display: flex;
	align-items: center;
	justify-content: center;
	color: rgba(var(--blue-rgb), 0.6);
	width: 16px;
	height: 16px;
	flex-shrink: 0;
}

.npm-links {
	display: flex;
	gap: 0.6rem;
	white-space: nowrap;
	flex-shrink: 0;
	align-items: center;

	a {
		font-size: 11px;
		color: rgba(var(--blue-rgb), 0.55);
		text-decoration: none;
		transition: color 0.15s;
		display: flex;
		align-items: center;

		&:hover {
			color: var(--blue);
		}
	}
}

/* ══════════════════════════════════════
   ② TERMINAL — Deprecated
══════════════════════════════════════ */

.s-deprecated {
	animation: fadeUp 0.4s ease 0.12s both;
	background: #030a03;
	border: 1px solid #122012;
	overflow: hidden;

	--dep-glow-rgb: 90, 154, 90;

	.entry-name {
		color: #6ab86a;
		text-shadow: 0 0 10px rgba(var(--dep-glow-rgb), 0.7);
	}

	.entry-desc {
		padding-left: 1.5rem;
		color: #5aaa5a;
		text-shadow: 0 0 8px rgba(var(--dep-glow-rgb), 0.3);
	}

	.tags {
		padding-left: 1.5rem;
		margin-bottom: 0.35rem;
	}

	.tag {
		border: 1px solid #1e4a1e;
		color: #3a6a3a;
	}
}

.term-bar {
	background: #0e1e0e;
	border-bottom: 1px solid #122012;
}

.term-bar-title {
	font-size: 9px;
	color: #4a8a4a;
	margin-left: 0.5rem;
	text-shadow: 0 0 8px rgba(var(--dep-glow-rgb), 0.5);
}

.term-body {
	padding: 1.5rem 1.5rem 1.75rem;
}

.dep-intro {
	font-size: 12px;
	color: #4a8a4a;
	font-style: italic;
	margin-bottom: 1.5rem;
	padding-left: 1.25rem;
	text-shadow: 0 0 8px rgba(var(--dep-glow-rgb), 0.4);
}

.dep-entry {
	margin-bottom: 1.5rem;
	padding-bottom: 1.5rem;
	border-bottom: 1px dashed #0e200e;

	&:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}
}

.dep-head {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 0.4rem;
}

.dep-name-wrap {
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.dep-icon--svg {
	display: flex;
	align-items: center;
	justify-content: center;
	color: #4a8a4a;
	width: 20px;
	height: 20px;
	flex-shrink: 0;
}

.dep-prompt {
	font-size: 12px;
	color: #4a8a4a;
	text-shadow: 0 0 8px rgba(var(--dep-glow-rgb), 0.5);
}

.dep-badge {
	font-family: var(--font-display);
	font-size: 8px;
	padding: 2px 6px;
	border: 1px solid #2a5a2a;
	color: #4a8a4a;
	white-space: nowrap;
	flex-shrink: 0;
}

.dep-links {
	display: flex;
	gap: 0.75rem;
	align-items: center;
	margin-left: auto;

	a {
		font-size: 11px;
		color: #4a8a4a;
		text-decoration: none;
		transition:
			color 0.15s,
			text-shadow 0.15s;
		text-shadow: 0 0 8px rgba(var(--dep-glow-rgb), 0.4);
		display: flex;
		align-items: center;

		&:hover {
			color: var(--green);
			text-shadow: 0 0 10px rgba(74, 222, 128, 0.6);
		}
	}
}

/* ── FOOTER ── */

footer {
	margin-top: 4rem;
	padding-top: 1.5rem;
	border-top: 1px solid var(--border);
	display: flex;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 0.5rem;
	font-size: 12px;
	color: var(--muted);
	font-style: italic;

	a {
		color: var(--blue);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}
}
</style>
