---
import resume from "../../data/resume";
import Links from "../components/Links.astro";
import Contacts from "../components/resume/Contacts.astro";
import Education from "../components/resume/Education.astro";
import Experiences from "../components/resume/Experiences.astro";
import Extras from "../components/resume/Extras.astro";
import Interests from "../components/resume/Interests.astro";
import Me from "../components/resume/Me.astro";
import Projects from "../components/resume/Projects.astro";
import Skills from "../components/resume/Skills.astro";
import Layout from "../layouts/Layout.astro";
---

<script>
const urlSearchParams = new URLSearchParams(window.location.search);
for (const flag of ["alt", "private"]) {
	if (urlSearchParams.has(flag)) {
		document.body.classList.add(flag);
		document.documentElement.classList.add(flag);
	}
}
</script>
<Layout
	title="Luca Lischetti — Resume"
	description="Luca Lischetti's resume. Senior Full Stack Engineer with expertise across the entire stack — from React and React Native on the client to Node.js, GraphQL, and cloud infrastructure on the server."
	keywords={[
    "Luca Lischetti",
    "sirlisko",
    "full stack engineer",
    "full stack developer",
    "software engineer",
    "resume",
    "cv",
  ]}
	ogType="profile"
>
	<Links inverted page="resume" />
	<div class="resume">
		<Me />
		<div class="wrapper">
			<Skills skills={resume.skills} />
			<Experiences experiences={resume.experiences} />
			<section class="section ouat">
				<h2>Once upon a time...</h2>
				I've also worked with Python, Java, Scala, PHP, MySQL, C++, and Ruby on
				Rails — years of curiosity and exploring different parts of the stack.
			</section>
			<section class="section">
				<h2>Freelancing</h2>
				<ul>
					<li>
						Delivered commercial websites and bespoke solutions using WordPress,
						Gatsby, and Astro.
					</li>
					<li>
						Integrated headless CMS platforms including Sanity.io and others for
						content management.
					</li>
					<li>
						Built custom serverless features using Netlify Functions and AWS
						Lambda.
					</li>
				</ul>
			</section>
			<Projects projects={resume.projects} /> <Education /> <Extras />
			<Interests /> <Contacts />
		</div>
	</div>
</Layout>

<style is:global>
:root {
	--side: 18em;
}

html {
	background-color: var(--gradient-resume-color);
}
html.alt {
	background-color: #fff;
}
body {
	background-color: var(--gradient-resume-color);
	background-image: var(--gradient-resume);
	color: var(--white);
	min-height: 100vh;
}
body.alt {
	background-color: #fff;
	background-image: radial-gradient(circle, #fff, #fff);
	color: #000;
}
.wrapper {
	padding-bottom: 100px;
}

@page {
	padding: 1cm 0;
}

.resume {
	@media (max-width: 1150px) {
		font-size: 1.2vw;
	}
	@media print, (max-width: 650px) {
		font-size: 9px;
	}
	& a {
		color: var(--white);
	}

	& section {
		line-height: 1.5;
		margin: 1rem;
		overflow: hidden;
	}

	& h2 {
		font-size: 2em;
		margin: 0.67em 0;
		color: #c200c0;
	}
	& h3 {
		font-size: 1.5em;
		text-transform: capitalize;
		margin: 1rem auto 0.5rem;
		@media print, (min-width: 651px) {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		&,
		& a {
			color: #00bcbc;
		}
		& span {
			color: var(--white);
			font-size: 0.5rem;
			@media (max-width: 650px) {
				display: block;
				margin-top: 0.25rem;
			}
		}
	}

	& h4 {
		margin-top: 0.5rem;
	}

	& .wrapper {
		overflow: hidden;
		margin: 0 auto;
		max-width: 1200px;
	}

	& .me {
		margin: 20px auto 0;
		max-width: 1200px;
	}
	& .me__face {
		margin: 0 2em;
		width: var(--side);
		& img {
			display: block;
			margin: 0 auto;
			width: 8em;
		}
	}
	& .me__face,
	& .me__intro {
		display: inline-block;
		vertical-align: middle;
	}
	& .me__intro {
		font-size: 2em;
		line-height: 1.5;
		& span {
			display: block;
		}
	}

	& .skills > div {
		@media print, (max-width: 650px) {
			display: inline-block;
			vertical-align: top;
		}
	}
}

.alt h2 {
	color: red;
}
.alt a {
	color: currentColor;
}
.alt h3,
.alt h3 a {
	color: blue;

	& span {
		color: #000;
	}
}

@media print, screen and (min-width: 651px) {
	.resume .skills {
		float: left;
		width: var(--side);
	}

	.resume .experiences {
		margin-left: calc(var(--side) + 5em);
	}
}
@media screen and (min-width: 651px) {
	.resume .section {
		margin-left: calc(var(--side) + 5em);
	}
}
@media screen and (max-width: 650px) {
	.resume .me {
		text-align: center;
		width: 95%;
	}
}

@media print {
	html {
		background-color: unset;
	}
	.wrapper {
		padding-bottom: 0;
	}
	@page {
		margin: 0;
	}
	.nav {
		display: none;
	}
	.resume {
		padding: 0 35px 12px;
		& section {
			margin: 0.4rem 1rem;
			break-inside: avoid;
		}
		& .experiences > div {
			break-inside: avoid;
		}
		& h2 {
			margin: 0.3em 0;
		}
		& .me {
			margin-top: 8px;
		}
		& h3 a {
			text-decoration: none;
		}
		& .ouat {
			padding-top: 12px;
		}
	}
}
</style>
