---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import resume, { type Rich } from "../../data/resume";
import Links from "../components/Links.astro";
import Contacts from "../components/resume/Contacts.astro";
import Frame from "../components/resume/Frame.astro";
import Hero from "../components/resume/Hero.astro";
import Proficiencies from "../components/resume/Proficiencies.astro";
import QuestLog from "../components/resume/QuestLog.astro";
import SideQuests from "../components/resume/SideQuests.astro";
import Layout from "../layouts/Layout.astro";

const rich = (text: Rich) => [text].flat();
---

<Layout
	title="Resume"
	description="Luca Lischetti's resume. Senior software engineer working across the full stack, from TypeScript, React and React Native to Node.js and cloud infrastructure."
	keywords={[
    "Luca Lischetti",
    "sirlisko",
    "full stack engineer",
    "full stack developer",
    "software engineer",
    "resume",
    "cv",
  ]}
	ogType="profile"
	colorScheme="dark"
	themeColor={{ light: "#2f4a3a", dark: "#0b2440" }}
>
	<Links page="resume" />
	<main class="sheet">
		<Hero stats={resume.stats} />

		<div class="columns">
			<div class="main">
				<QuestLog experiences={resume.experiences} earlier={resume.earlier} />
				<SideQuests quests={resume.sideQuests} />
			</div>

			<div class="side">
				<Proficiencies skills={resume.skills} />

				<Frame title="Lore" printTitle="Education" id="lore">
					<p>
						{rich(resume.lore).map((s) =>
							typeof s === "string" ? s : <a href={s.url}>{s.text}</a>,
						)}
					</p>
				</Frame>

				<Frame title="Feats" printTitle="Achievements" id="feats">
					<ul>
						{resume.feats.map((feat) => (
							<li>
								{rich(feat).map((s) =>
									typeof s === "string" ? s : <a href={s.url}>{s.text}</a>,
								)}
							</li>
						))}
					</ul>
				</Frame>

				<Frame title="Traits" id="traits">
					<ul>
						{resume.traits.map((t) => <li>{t}</li>)}
					</ul>
				</Frame>

				<Frame title="Ideals" id="ideals">
					<ul>
						{resume.ideals.map((i) => <li>{i}</li>)}
					</ul>
				</Frame>

				<Frame title="Downtime" id="downtime">
					<p>{resume.downtime}</p>
				</Frame>
			</div>
		</div>

		<Contacts />
	</main>
</Layout>

<style is:global>
html {
	--felt: #2f4a3a;
	--ink: #111;
	--paper: #fff;
	--blood: #8f1d1d;
	--faded: #555;
	background-color: var(--felt);
	background-image:
		linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
		linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
	background-size: 40px 40px;
	/* Keeps the pixel corners and legend backgrounds when backgrounds are off. */
	print-color-adjust: exact;
	-webkit-print-color-adjust: exact;
}
::selection {
	background: var(--ink);
	color: var(--paper);
}
/* Print stays on white paper whatever the system theme. */
@media screen and (prefers-color-scheme: dark) {
	html {
		--felt: #0b2440;
		--ink: #eaf2ff;
		--paper: #1d4e89;
		--blood: #ffd166;
		--faded: #a9c7ec;
		background-image: none;
	}
}
@media screen {
	.print {
		display: none;
	}
}
@media print {
	html {
		background: var(--paper);
	}
	.nav,
	.screen {
		display: none;
	}
}

@page {
	size: A4;
	margin: 0;
}
</style>

<style>
.sheet {
	max-width: 1120px;
	margin: 6rem auto 4.5rem;
	padding: 2.5rem 2.25rem;
	background: var(--paper);
	box-shadow: 0 10px 0 rgb(0 0 0 / 0.35);
	color: var(--ink);
	font-family: var(--font-mono);
	font-size: 0.9375rem;
	line-height: 1.6;
	text-wrap: pretty;
	display: flex;
	flex-direction: column;
	gap: 2.5rem;
}

/* Shared by the section components; :where() keeps them below a component's own styles. */
:where(.sheet) {
	& :global(a) {
		color: var(--blood);
		&:hover {
			color: var(--ink);
		}
		&:focus-visible {
			outline: 3px solid var(--blood);
			outline-offset: 3px;
		}
	}
	& :global(:is(p, ul, dl, dd, h1, h2, h3)) {
		margin: 0;
	}
	& :global(ul) {
		padding-left: 1.25rem;
		list-style: square;
	}
	& :global(.label) {
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--faded);
	}
}

.columns {
	display: grid;
	grid-template-columns: 1fr 22rem;
	align-items: start;
	gap: 2.5rem 1.75rem;
}
.side,
.main {
	display: flex;
	flex-direction: column;
	gap: 2.5rem;
}

/* Blueprint: the grid moves from the table onto the sheet. */
@media screen and (prefers-color-scheme: dark) {
	.sheet {
		background-image:
			linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px);
		background-size: 20px 20px;
	}
}

@media screen and (max-width: 800px) {
	.columns {
		grid-template-columns: 1fr;
	}
	.sheet {
		margin: 5rem 1rem 3rem;
		padding: 2rem 1rem;
	}
}

/*
 * Print is the white sheet alone, filling one A4 page: lay out wider than the
 * screen, then zoom down. The quest log sets the height; 0.555 is the most that
 * fits in Chrome and Firefox, so 0.55 leaves a little slack for new content.
 */
@media print {
	.sheet {
		width: 1400px;
		max-width: none;
		margin: 0 auto;
		padding: 2.5rem 3rem;
		gap: 1.75rem;
		box-shadow: none;
		zoom: 0.55;
		/* On paper a link is only as good as the address printed next to it. */
		& :global(a[data-url])::after {
			content: "(" attr(data-url) ")";
			display: inline-block;
			margin-left: 0.4em;
			color: var(--faded);
			font-size: 0.875rem;
			font-weight: 400;
		}
	}
	.columns {
		grid-template-columns: 1fr 24rem;
	}
	.side,
	.main {
		gap: 1.75rem;
	}
}
</style>
