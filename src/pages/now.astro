---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-400-italic.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import me from "../../data/me";
import { NOW_LAST_UPDATED, sections } from "../../data/now";
import FaceLink from "../components/FaceLink.astro";
import Links from "../components/Links.astro";
import Maze from "../components/now/Maze.astro";
import Trail from "../components/now/Trail.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Now"
	description="What Luca Lischetti (sirlisko) is up to right now"
	keywords={[
    "sirlisko",
    "now",
    "Luca Lischetti",
    "what I'm doing",
  ]}
	theme="dark"
>
	<Links page="now" />
	<main class="page">
		<FaceLink width={48} />

		<header>
			<div class="stats">
				<p><span class="key">Loc</span> London, UK</p>
				<p><span class="key">Date</span> {NOW_LAST_UPDATED}</p>
			</div>
			<h1>/now</h1>
			<p class="intro">
				A snapshot of what I'm focused on at this point in time.{" "}
				<a href="https://nownownow.com/about" target="_blank" rel="noopener"
					>What's a now page?</a
				>
			</p>
			<Trail />
		</header>

		{sections.map((section, i) => <Maze section={section} index={i} />)}

		<footer class="coin">
			<p class="credit">Insert coin</p>
			<p>
				Want to chase something together? Say ciao at{" "}
				<a href={`mailto:${me.email}`}>{me.email}</a>.
			</p>
		</footer>
	</main>
</Layout>

<style>
/* Bound to the theme class so it outranks the display font Layout sets on body. */
body.dark {
	background: #000;
	font-family: var(--font-mono);
	font-size: 16px;
	line-height: 1.7;
}

.page {
	max-width: 800px;
	margin: 0 auto;
	padding-top: 3rem;
	display: flex;
	flex-direction: column;
	gap: 2.5rem;
}

header {
	display: flex;
	flex-direction: column;
	gap: 1.25rem;
}

.stats {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem 2.5rem;

	p {
		margin: 0;
	}
}

.key {
	font-family: var(--font-display);
	color: #ffe14d;
	margin-right: 0.5rem;
}

h1 {
	font-family: var(--font-display);
	font-weight: 400;
	font-size: 48px;
	line-height: 1.2;
	color: var(--white);
	margin: 0;

	@media (max-width: 600px) {
		font-size: 32px;
	}
}

.intro {
	margin: 0;
	max-width: 60ch;
	font-size: 18px;
	line-height: 1.6;
}

header p {
	color: #e4e4e4;
}

.coin {
	margin-top: 3.5rem;
	text-align: center;
	font-size: 16px;
	color: #e4e4e4;

	p {
		margin: 0;
	}
}

.coin .credit {
	margin-bottom: 1rem;
	font-family: var(--font-display);
	color: #ffe14d;
}

:is(.intro, .coin) a {
	color: #ffe14d;

	&:hover {
		color: var(--white);
	}

	&:focus-visible {
		outline: 3px solid #ffe14d;
		outline-offset: 3px;
	}
}
</style>
