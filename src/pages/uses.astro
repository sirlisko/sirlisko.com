---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-400-italic.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import me from "../../data/me";
import {
	cli,
	DOTFILES_SOURCE,
	hardware,
	USES_LAST_UPDATED,
	USES_SOURCE,
	uses,
} from "../../data/uses";
import FaceLink from "../components/FaceLink.astro";
import Links from "../components/Links.astro";
import Listing from "../components/uses/Listing.astro";
import Prompt from "../components/uses/Prompt.astro";
import Terminal from "../components/uses/Terminal.astro";
import Layout from "../layouts/Layout.astro";

const EXITS = [
	{ name: "home", url: "/" },
	{ name: "projects", url: "/projects" },
	{ name: "now", url: "/now" },
	{ name: "resume", url: "/resume" },
];
---

<Layout
	title="Uses"
	description="The apps and tools Luca Lischetti (sirlisko) actually uses day to day — browser, editor, notes, passwords, and everything else running the show."
	keywords={[
    "sirlisko",
    "uses",
    "Luca Lischetti",
    "apps",
    "tools",
    "setup",
  ]}
	theme="dark"
>
	<Links page="uses" />
	<main>
		<FaceLink width={48} />
		<header>
			<h1>Uses</h1>
			<p>The hardware and software I use daily, as a text adventure.</p>
		</header>

		<Terminal title="luca@sirlisko: ~ (zork)" location="Desk, London" moves={5}>
			<Prompt command="look" />
			<p class="say room">Desk, London</p>
			<p class="say">
				You're at a desk in a flat in London. A monitor glows, a kneeling chair
				waits, and cables lead off in every direction. There is a small mailbox
				here.
			</p>
			<p class="say">
				Obvious exits:{" "}
				{EXITS.map((exit, i) => (
					<>
						{i > 0 && ", "}
						<a href={exit.url}>{exit.name}</a>
					</>
				))}.
			</p>

			<Prompt command="inventory" />
			<p class="say">You are carrying:</p>
			<Listing items={hardware} inventory />

			<Prompt command="examine apps" />
			<p class="say">Inside the toolbox you find:</p>
			<Listing items={uses} />

			<Prompt command="examine dotfiles" />
			<p class="say">
				The{" "}
				<a href={DOTFILES_SOURCE} target="_blank" rel="noopener noreferrer"
					>dotfiles</a
				>{" "}
				unfold into:
			</p>
			<Listing items={cli} />

			<Prompt command="open mailbox" />
			<p class="say">
				Opening the small mailbox reveals a leaflet. It reads: "Ideas, projects
				or just a ciao, write to{" "}
				<a href={`mailto:${me.email}`}>{me.email}</a>."
			</p>

			<Prompt />
		</Terminal>

		<footer>
			Started as{" "}
			<a href={USES_SOURCE} target="_blank" rel="noopener">a blog post</a>, last
			updated {USES_LAST_UPDATED}.
		</footer>
	</main>
</Layout>

<style>
body.dark {
	background: #1b1c24;
}

main {
	max-width: 880px;
	margin: 0 auto;
	padding-top: 2rem;
	font-family: var(--font-mono);
}

header {
	margin-bottom: 2.5rem;
	animation: fadeUp 0.4s ease both;

	h1 {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(22px, 5vw, 34px);
		line-height: 1.4;
		color: var(--white);
	}

	p {
		color: #a4a2ae;
		font-size: 16px;
	}
}

main > :global(.face-link) {
	margin-bottom: 2rem;
}

.say {
	margin: 0.6rem 0 0;

	a {
		color: var(--snazzy-yellow);
	}
}

.room {
	font-weight: 600;
}

a {
	color: var(--yellow);

	&:hover {
		text-decoration: none;
	}

	&:focus-visible {
		outline: 2px solid var(--yellow);
		outline-offset: 2px;
	}
}

footer {
	margin-top: 2rem;
	font-size: 15px;
	color: #a4a2ae;
}
</style>
