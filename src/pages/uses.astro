---
import {
	cli,
	DOTFILES_SOURCE,
	DOTFILES_SOURCE_LABEL,
	hardware,
	USES_LAST_UPDATED,
	USES_SOURCE,
	USES_SOURCE_LABEL,
	uses,
} from "../../data/uses";
import FaceLink from "../components/FaceLink.astro";
import Links from "../components/Links.astro";
import UsesList from "../components/UsesList.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Uses"
	description="The apps and tools Luca Lischetti (sirlisko) actually uses day to day — browser, editor, notes, passwords, and everything else running the show."
	keywords={[
    "sirlisko",
    "uses",
    "Luca Lischetti",
    "apps",
    "tools",
    "setup",
  ]}
	theme="doc"
>
	<Links inverted page="uses" />
	<main class="page">
		<FaceLink />
		<header>
			<p class="eyebrow">// things I use</p>
			<h1>Uses<span class="cursor"></span></h1>
			<p class="subtitle">The hardware and software I use daily.</p>
		</header>

		<h2 class="section-title">Hardware</h2>
		<UsesList items={hardware} />

		<h2 class="section-title">Software</h2>
		<UsesList items={uses} />

		<h2 class="section-title">CLI</h2>
		<UsesList items={cli} />

		<footer>
			<p>
				Based on{' '}
				<a href={USES_SOURCE} target="_blank" rel="noopener"
					>{USES_SOURCE_LABEL}</a
				>, updated whenever something changes.
			</p>
			<p>Last updated: <strong>{USES_LAST_UPDATED}</strong>.</p>
			<p>
				The full setup lives in my{' '}
				<a href={DOTFILES_SOURCE} target="_blank" rel="noopener noreferrer"
					>{DOTFILES_SOURCE_LABEL}</a
				>.
			</p>
		</footer>
	</main>
</Layout>

<style>
.subtitle {
	color: var(--muted);
	font-size: 14px;
	line-height: 1.7;
	max-width: 48ch;
}

.section-title {
	font-family: var(--font-display);
	font-size: 12px;
	letter-spacing: 0.08em;
	color: var(--yellow);
	margin: 0 0 1.4rem;
	animation: fadeUp 0.4s ease both;
}

footer {
	margin-top: 3rem;
	padding-top: 1.5rem;
	border-top: 1px solid #24242f;
	font-size: 13px;
	color: var(--muted);

	a {
		color: var(--yellow);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}
}
</style>
