---
import { Image } from "astro:assets";
import {
	cli,
	DOTFILES_SOURCE,
	DOTFILES_SOURCE_LABEL,
	hardware,
	USES_LAST_UPDATED,
	USES_SOURCE,
	USES_SOURCE_LABEL,
	uses,
} from "../../data/uses";
import Links from "../components/Links.astro";
import me_face from "../images/me.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Uses"
	description="The apps and tools Luca Lischetti (sirlisko) actually uses day to day — browser, editor, notes, passwords, and everything else running the show."
	keywords={[
    "sirlisko",
    "uses",
    "Luca Lischetti",
    "apps",
    "tools",
    "setup",
  ]}
>
	<Links inverted page="uses" />
	<main class="page">
		<a href="/" class="face-link">
			<Image
				src={me_face}
				alt="sirlisko face"
				class="face-img"
				width={60}
				height={86}
				densities={[1, 2]}
				transition:name="face"
			/>
		</a>
		<header>
			<p class="eyebrow">// things I use</p>
			<h1>Uses<span class="cursor"></span></h1>
			<p class="subtitle">The hardware and software I use daily.</p>
		</header>

		<h2 class="section-title">Hardware</h2>
		<ul class="uses-list">
			{hardware.map((u) => (
          <li class="uses-item">
            <span class="emoji" aria-hidden="true">{u.emoji}</span>
            <div class="uses-body">
              <p class="category">{u.category}</p>
              <p class="apps">
                {u.apps.map((app, i) => (
                  <>
                    {i > 0 && <span class="sep"> / </span>}
                    <a href={app.url} target="_blank" rel="noopener noreferrer">{app.name}</a>
                  </>
                ))}
              </p>
              {u.note && <p class="note">{u.note}</p>}
            </div>
          </li>
        ))}
		</ul>

		<h2 class="section-title">Software</h2>
		<ul class="uses-list">
			{uses.map((u) => (
          <li class="uses-item">
            <span class="emoji" aria-hidden="true">{u.emoji}</span>
            <div class="uses-body">
              <p class="category">{u.category}</p>
              <p class="apps">
                {u.apps.map((app, i) => (
                  <>
                    {i > 0 && <span class="sep"> / </span>}
                    {app.url ? (
                      <a href={app.url} target="_blank" rel="noopener noreferrer">{app.name}</a>
                    ) : (
                      <span>{app.name}</span>
                    )}
                  </>
                ))}
              </p>
              {u.note && <p class="note">{u.note}</p>}
            </div>
          </li>
        ))}
		</ul>

		<h2 class="section-title">CLI</h2>
		<ul class="uses-list">
			{cli.map((u) => (
          <li class="uses-item">
            <span class="emoji" aria-hidden="true">{u.emoji}</span>
            <div class="uses-body">
              <p class="category">{u.category}</p>
              <p class="apps">
                {u.apps.map((app, i) => (
                  <>
                    {i > 0 && <span class="sep"> / </span>}
                    {app.url ? (
                      <a href={app.url} target="_blank" rel="noopener noreferrer">{app.name}</a>
                    ) : (
                      <span>{app.name}</span>
                    )}
                  </>
                ))}
              </p>
              {u.note && <p class="note">{u.note}</p>}
            </div>
          </li>
        ))}
		</ul>

		<footer>
			<p>
				Based on{' '}
				<a href={USES_SOURCE} target="_blank" rel="noopener"
					>{USES_SOURCE_LABEL}</a
				>, updated whenever something changes.
			</p>
			<p>Last updated: <strong>{USES_LAST_UPDATED}</strong>.</p>
			<p>
				The full setup lives in my{' '}
				<a href={DOTFILES_SOURCE} target="_blank" rel="noopener noreferrer"
					>{DOTFILES_SOURCE_LABEL}</a
				>.
			</p>
		</footer>
	</main>
</Layout>

<style>
body {
	background: var(--bg);
	color: var(--text);
	min-height: 100vh;
	padding: 3rem 1.5rem 6rem;
}

.page {
	max-width: 720px;
	margin: 0 auto;
	padding-top: 3rem;
}

.face-link {
	margin-bottom: 2rem;
}

header {
	margin-bottom: 3rem;
	animation: fadeUp 0.4s ease both;
}

h1 {
	font-family: var(--font-display);
	font-size: clamp(22px, 5vw, 34px);
	color: var(--white);
	line-height: 1.4;
	margin-bottom: 0.85rem;
}

.eyebrow {
	font-family: var(--font-display);
	font-size: 9px;
	color: var(--yellow);
	letter-spacing: 0.15em;
	text-transform: uppercase;
	margin-bottom: 1rem;
}

.cursor {
	display: inline-block;
	width: 10px;
	height: 1em;
	background: var(--yellow);
	vertical-align: middle;
	animation: blink 1s step-end infinite;
	margin-left: 4px;
}

.subtitle {
	color: var(--muted);
	font-size: 14px;
	line-height: 1.7;
	max-width: 48ch;
}

.section-title {
	font-family: var(--font-display);
	font-size: 12px;
	letter-spacing: 0.08em;
	color: var(--yellow);
	margin: 0 0 1.4rem;
	animation: fadeUp 0.4s ease both;
}

.uses-list {
	list-style: none;
	margin: 0 0 3rem;
	padding: 0;
	animation: fadeUp 0.4s ease 0.06s both;

	&:last-of-type {
		margin-bottom: 0;
	}
}

.uses-item {
	display: flex;
	align-items: flex-start;
	gap: 1rem;
	margin-bottom: 1.7rem;
}

.emoji {
	font-size: 1.4rem;
	line-height: 1.5;
	width: 1.6rem;
	flex-shrink: 0;
	text-align: center;
}

.uses-body {
	min-width: 0;
}

.category {
	margin: 0 0 0.2rem;
	font-size: 10.5px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: var(--muted);
}

.apps {
	margin: 0;
	font-size: 16px;
	line-height: 1.6;

	a {
		color: var(--white);
		font-weight: 600;
		text-decoration: none;
		background-image: linear-gradient(var(--yellow), var(--yellow));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 1px;
		transition:
			background-size 0.15s ease,
			color 0.15s ease;

		&:hover {
			color: var(--yellow);
			background-size: 100% 1px;
		}
	}
}

.sep {
	color: var(--muted);
	font-weight: 400;
	margin: 0 0.15rem;
}

.note {
	margin: 0.35rem 0 0;
	font-size: 13px;
	color: #9a9aac;
	line-height: 1.65;
}

footer {
	margin-top: 3rem;
	padding-top: 1.5rem;
	border-top: 1px solid #24242f;
	font-size: 13px;
	color: var(--muted);

	a {
		color: var(--yellow);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}
}
</style>
