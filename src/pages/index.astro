---
import me from "../../data/me";
import Face from "../components/Face.astro";
import Ghost from "../components/Ghost.astro";
import Greeting from "../components/Greeting.astro";
import Lamp from "../components/Lamp.astro";
import Links from "../components/Links.astro";
import SayCiao from "../components/SayCiao.astro";
import { AUTHOR, SITE_URL } from "../config";
import Layout from "../layouts/Layout.astro";
---

<Layout
	keywords={me.keywords}
	themeColor={{ light: "#2eaed5", dark: "#051a22" }}
>
	<Ghost />
	<div class="page-container h-card">
		<data class="p-name" value={AUTHOR.name}></data>
		<data class="p-nickname" value={AUTHOR.username}></data>
		<data class="u-url u-uid" value={SITE_URL}></data>
		<data class="u-photo" value={`${SITE_URL}/images/avatar.png`}></data>
		<Links />
		<main class="main-content">
			<div class="container grid">
				<div class="face">
					<Lamp />
					{/* The face is min(70vw, 70vh) tall at a 0.7 aspect ratio, so its width tops out at 49% of the smaller side. */}
					<span class="head">
						<Face
							alt="sirlisko face"
							widths={[400, 700, 1000, 1244]}
							sizes="(max-aspect-ratio: 1/1) 49vw, 49vh"
							loading="eager"
							fetchpriority="high"
						/>
						{/* Drawn on the photo's own 21×30 pixel grid, over the crown. */}
						<svg
							class="shine"
							viewBox="0 0 21 30"
							preserveAspectRatio="none"
							shape-rendering="crispEdges"
							aria-hidden="true"
						>
							<path
								d="M8 2h5v1H8zM7 3h2v1H7zM12 3h2v1h-2z"
								fill="rgb(var(--lamp) / 0.45)"
							/>
							<path d="M9 3h3v1H9zM8 4h2v1H8z" fill="rgb(255 250 235 / 0.8)" />
						</svg>
					</span>
				</div>
				<div class="intro">
					<h1>
						Ciao! <br>
						I&#39;m sirlisko,
						<span>another f@$#&amp;n&#39;</span>
						<span class="desc">
							<Greeting descriptions={me.descriptions} />
						</span>
					</h1>
				</div>
			</div>
		</main>
		<footer>
			<SayCiao />
		</footer>
	</div>
</Layout>

<style>
html,
body {
	height: 100%;
	background-color: var(--gradient-home-color);
	background-image: var(--gradient-home);
	background-attachment: fixed;
}

.main-content {
	flex-grow: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 1rem;
	min-height: 100dvh;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10vw;
}

@media (max-width: 650px) {
	.grid {
		grid-template-columns: 1fr;
	}
}

.intro {
	line-height: 1.5;
	display: flex;
	align-items: center;
	text-align: left;
}
.intro span,
.intro h1 {
	font-size: min(2.5vw, 55px);
	margin: 0;
	display: block;
}

.face {
	text-align: center;
}
/* Positioned so the ghost passes behind the photo, but not behind the rest of its column. */
.head {
	position: relative;
	display: inline-block;
	vertical-align: top;
}
.shine {
	display: none;
}
.face img {
	position: relative;
	height: min(70vw, 70dvh);
	/* the intrinsic width/height attributes are presentational hints, so the
	   width has to be released explicitly for the aspect ratio to win */
	width: auto;
}
/* At night a lamp hangs over the head, and now and then the wiring gives. */
@media (prefers-color-scheme: dark) {
	html,
	body {
		background-color: var(--gradient-home-night-color);
		background-image: var(--gradient-home-night);
		color: #e6f6fb;
	}

	.main-content {
		overflow: clip;
	}

	.face {
		position: relative;
	}

	.face img {
		filter: brightness(0.95) sepia(0.15);
		animation: flicker-face 11s -7s infinite;
	}

	.face:has([data-lamp][aria-pressed="false"]) img {
		filter: brightness(0.35) sepia(0.15);
		animation: none;
	}

	/* The bulb catches the top of a bald head. */
	.shine {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		animation: flicker-shine 11s -7s infinite;
	}

	.face:has([data-lamp][aria-pressed="false"]) .shine {
		display: none;
	}
}

@keyframes flicker-shine {
	0%,
	90%,
	91.5%,
	93.5%,
	100% {
		opacity: 1;
	}
	90.5% {
		opacity: 0.2;
	}
	92.5% {
		opacity: 0;
	}
}

@keyframes flicker-face {
	0%,
	90%,
	91.5%,
	93.5%,
	100% {
		filter: brightness(0.95) sepia(0.15);
	}
	90.5% {
		filter: brightness(0.6) sepia(0.15);
	}
	92.5% {
		filter: brightness(0.45) sepia(0.15);
	}
}

@media screen and (max-width: 650px) {
	.face {
		max-height: 50dvh;
	}
	.intro span,
	.intro h1 {
		font-size: min(5vw, 5dvh);
	}
}
</style>
