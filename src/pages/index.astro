---
import { Image } from "astro:assets";
import me from "../../data/me";
import Ghost from "../components/Ghost.astro";
import Greeting from "../components/Greeting.astro";
import Links from "../components/Links.astro";
import me_face from "../images/me.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout keywords={me.keywords}>
	<Ghost />
	<div class="page-container">
		<Links />
		<main class="main-content">
			<div class="container grid">
				<div class="face">
					<Image
						src={me_face}
						alt="sirlisko face"
						class="face-img"
						widths={[400, 700, 1000, 1244]}
						sizes="(max-width: 650px) 90vw, 50vw"
						loading="eager"
						fetchpriority="high"
						transition:name="face"
					/>
				</div>
				<div class="intro">
					<h1>
						Ciao! <br>
						I&#39;m sirlisko,
						<span>another f@$#&amp;n&#39;</span>
						<span class="desc">
							<Greeting descriptions={me.descriptions} />
						</span>
					</h1>
				</div>
			</div>
		</main>
	</div>
</Layout>

<style>
html,
body {
	height: 100%;
	background-color: var(--gradient-home-color);
	background-image: var(--gradient-home);
	background-attachment: fixed;
}

.main-content {
	flex-grow: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 1rem;
	min-height: 100vh;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10vw;
}

@media (max-width: 650px) {
	.grid {
		grid-template-columns: 1fr;
	}
}

.intro {
	line-height: 1.5;
	display: flex;
	align-items: center;
	text-align: left;
}
.intro span,
.intro h1 {
	font-size: min(2.5vw, 55px);
	margin: 0;
	display: block;
}

.face {
	text-align: center;
	position: relative;
}
.face img {
	height: min(70vw, 70vh);
	/* the intrinsic width/height attributes are presentational hints, so the
	   width has to be released explicitly for the aspect ratio to win */
	width: auto;
}
@media screen and (max-width: 650px) {
	.face {
		max-height: 50vh;
	}
	.intro span,
	.intro h1 {
		font-size: min(5vw, 5vh);
	}
}
</style>
