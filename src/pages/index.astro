---
import me from "../../data/me";
import Face from "../components/Face.astro";
import Ghost from "../components/Ghost.astro";
import Greeting from "../components/Greeting.astro";
import Links from "../components/Links.astro";
import SayCiao from "../components/SayCiao.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout keywords={me.keywords}>
	<Ghost />
	<div class="page-container">
		<Links />
		<main class="main-content">
			<div class="container grid">
				<div class="face">
					{/* The face is min(70vw, 70vh) tall at a 0.7 aspect ratio, so its width tops out at 49% of the smaller side. */}
					<Face
						alt="sirlisko face"
						widths={[400, 700, 1000, 1244]}
						sizes="(max-aspect-ratio: 1/1) 49vw, 49vh"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="intro">
					<h1>
						Ciao! <br>
						I&#39;m sirlisko,
						<span>another f@$#&amp;n&#39;</span>
						<span class="desc">
							<Greeting descriptions={me.descriptions} />
						</span>
					</h1>
				</div>
			</div>
		</main>
		<footer>
			<SayCiao />
		</footer>
	</div>
</Layout>

<style>
html,
body {
	height: 100%;
	background-color: var(--gradient-home-color);
	background-image: var(--gradient-home);
	background-attachment: fixed;
}

.main-content {
	flex-grow: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 1rem;
	min-height: 100dvh;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10vw;
}

@media (max-width: 650px) {
	.grid {
		grid-template-columns: 1fr;
	}
}

.intro {
	line-height: 1.5;
	display: flex;
	align-items: center;
	text-align: left;
}
.intro span,
.intro h1 {
	font-size: min(2.5vw, 55px);
	margin: 0;
	display: block;
}

.face {
	text-align: center;
}
/* Positioned so the ghost passes behind the photo, but not behind the rest of its column. */
.face img {
	position: relative;
	height: min(70vw, 70dvh);
	/* the intrinsic width/height attributes are presentational hints, so the
	   width has to be released explicitly for the aspect ratio to win */
	width: auto;
}
@media screen and (max-width: 650px) {
	.face {
		max-height: 50dvh;
	}
	.intro span,
	.intro h1 {
		font-size: min(5vw, 5dvh);
	}
}
</style>
