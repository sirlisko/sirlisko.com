---
import { getCollection } from "astro:content";
import BackLink from "../../../components/blog/BackLink.astro";
import Main from "../../../components/blog/Main.astro";
import { AUTHOR } from "../../../config";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { postUrl, publishedPosts } from "../../../lib/blog/posts";

// Listed by when they were first published, not by when they were bumped.
const posts = publishedPosts(await getCollection("posts")).sort(
	(a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime(),
);
const firstYear = posts.at(-1)?.data.pubDatetime.getFullYear();
const monthName = new Intl.DateTimeFormat("en", { month: "long" });

const years = [
	...Map.groupBy(posts, (post) => post.data.pubDatetime.getFullYear()),
];
---

<BlogLayout
	title="Archives"
	description={`Every post on ${AUTHOR.name}'s blog since ${firstYear}, by year and month.`}
>
	<BackLink href="/blog" label="/blog" />
	<Main title="Archives" description="Every post, by month.">
		{years.map(([year, yearPosts]) => (
			<section class="year">
				<h2 class="font-pixel">
					{year}
					<span class="sr-only">({yearPosts.length} posts)</span>
				</h2>
				<div>
					{[...Map.groupBy(yearPosts, (post) => post.data.pubDatetime.getMonth())].map(
						([month, monthPosts]) => (
							<>
								<h3>{monthName.format(new Date(2000, month, 1))}</h3>
								<ul>
									{monthPosts.map((post) => (
										<li>
											<a href={postUrl(post)} class="row">
												<span class="day">
													{String(post.data.pubDatetime.getDate()).padStart(2, "0")}
												</span>
												<span>{post.data.title}</span>
											</a>
										</li>
									))}
								</ul>
							</>
						),
					)}
				</div>
			</section>
		))}
	</Main>
</BlogLayout>

<style>
.year {
	display: grid;
	grid-template-columns: 7.5rem minmax(0, 1fr);
	gap: 1.5rem;
	padding-top: 1.75rem;
	margin-top: 1.25rem;
	background-image: linear-gradient(90deg, var(--pea) 50%, transparent 50%);
	background-size: 8px 4px;
	background-repeat: repeat-x;

	@media (width < 640px) {
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}
}

h2 {
	font-size: 1.125rem;
	line-height: 1.375;
}

h3 {
	margin-bottom: 0.25rem;
	font-size: 13px;
	font-weight: 600;
	color: var(--muted-foreground);
}

ul {
	margin-bottom: 1.25rem;
}

.row {
	display: grid;
	grid-template-columns: 2.75rem minmax(0, 1fr);
	gap: 0.75rem;
	padding: 0.25rem 0.5rem;
	margin-inline: -0.5rem;
	font-size: 15px;

	&:hover,
	&:focus-visible {
		background: var(--foreground);
		color: var(--background);
		outline: none;

		.day {
			color: inherit;
		}
	}
}

.day {
	color: var(--muted-foreground);
}
</style>
