---
import "@pagefind/default-ui/css/ui.css";
import BackLink from "../../components/blog/BackLink.astro";
import Main from "../../components/blog/Main.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
---

<BlogLayout title="Search" noindex>
	<BackLink href="/blog" label="/blog" />
	<Main title="Search">
		<Fragment slot="description">
			Search every post by title or text, or browse the{" "}
			<a href="/blog/tags" class="tag-link">tags</a>.
		</Fragment>
		<div
			id="pagefind-search"
			transition:persist
			data-bundle-path="/blog/pagefind/"
		></div>
		<p class="sr-only" role="status" data-search-status></p>
	</Main>
</BlogLayout>

<script>
import { rememberBackUrl } from "../../lib/blog/backUrl";
import { debounce } from "../../lib/debounce";

const ANNOUNCE_DELAY = 500;

const initSearch = () => {
	const el = document.querySelector<HTMLElement>("#pagefind-search");
	// The element persists across navigations, so a filled one is already set up.
	if (!el || el.querySelector("form")) {
		return;
	}
	const params = new URLSearchParams(location.search);
	const onIdle =
		window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1));

	onIdle(async () => {
		// @ts-expect-error: @pagefind/default-ui ships no types.
		const { PagefindUI } = await import("@pagefind/default-ui");

		if (import.meta.env.DEV) {
			el.innerHTML = `<p class="dev-warning">The search index is built by <code>pnpm build</code>, so run it once to search in dev.</p>`;
		}

		const search = new PagefindUI({
			element: "#pagefind-search",
			bundlePath: el.dataset.bundlePath,
			showImages: false,
			showSubResults: true,
			// The query goes in the URL, so a post's back link returns to these results.
			processTerm: (term: string) => {
				params.set("q", term);
				history.replaceState(history.state, "", `?${params}`);
				rememberBackUrl(`${location.pathname}?${params}`);
				return term;
			},
		});

		// Pagefind's result count isn't a live region; debounced so typing doesn't read out every keystroke.
		const announceResults = debounce(() => {
			const status = document.querySelector("[data-search-status]");
			const message =
				el.querySelector(".pagefind-ui__message")?.textContent ?? "";
			if (status && status.textContent !== message) {
				status.textContent = message;
			}
		}, ANNOUNCE_DELAY);
		new MutationObserver(announceResults).observe(el, {
			subtree: true,
			childList: true,
			characterData: true,
		});

		const query = params.get("q");
		if (query) {
			search.triggerSearch(query);
		}

		const clearParam = (e: Event) => {
			if ((e.target as HTMLInputElement | null)?.value?.trim() === "") {
				history.replaceState(history.state, "", location.pathname);
			}
		};
		const input = el.querySelector(".pagefind-ui__search-input");
		// Pagefind names the input only with a title, which not every screen reader reads.
		input?.setAttribute("aria-label", "Search posts");
		input?.addEventListener("input", clearParam);
		el.querySelector(".pagefind-ui__search-clear")?.addEventListener(
			"click",
			clearParam,
		);
	});
};

document.addEventListener("astro:page-load", initSearch);
</script>

<style is:global>
#pagefind-search {
	--pagefind-ui-font: var(--font-app);
	--pagefind-ui-text: var(--foreground);
	--pagefind-ui-background: var(--background);
	--pagefind-ui-border: var(--pea);
	--pagefind-ui-primary: var(--accent);
	--pagefind-ui-tag: var(--background);
	--pagefind-ui-border-radius: 0;
	--pagefind-ui-border-width: 2px;
	--pagefind-ui-image-border-radius: 8px;
	--pagefind-ui-image-box-ratio: 3 / 2;

	.dev-warning {
		margin-bottom: 1rem;
		padding: 1rem;
		background: var(--muted);
	}

	form::before {
		background-color: var(--foreground);
	}

	input {
		font-weight: 400;
		border: 4px solid var(--foreground);
		background: var(--muted);
		box-shadow: 6px 6px 0 var(--pea);
	}

	input:focus-visible {
		outline: 3px dashed var(--accent);
		outline-offset: 6px;
	}

	/* Inside the input's 4px border, in its colours, like the pixel buttons. */
	.pagefind-ui__search-clear {
		top: 4px;
		right: 4px;
		/* Pagefind's input is 64px at its scale. */
		height: calc(64px * var(--pagefind-ui-scale) - 8px);
		padding-inline: 14px;
		background: var(--muted);
		font-family: var(--font-pixel);
		font-size: 10px;

		&:hover {
			background: var(--foreground);
			color: var(--background);
		}
	}

	mark {
		background: var(--pea);
		color: var(--foreground);
		padding-inline: 2px;
	}

	.pagefind-ui__result-title a {
		color: var(--foreground);
		font-weight: 600;
		outline-offset: 1px;
		outline-color: var(--accent);
		text-decoration: underline dashed;
		text-underline-offset: 4px;
	}

	.pagefind-ui__result-title a:focus-visible,
	.pagefind-ui__search-clear:focus-visible {
		text-decoration-line: none;
		outline-width: 2px;
		outline-style: dashed;
	}

	/* Pagefind only fades out the empty box's Clear button, which leaves it a tab stop. */
	.pagefind-ui__suppressed {
		visibility: hidden;
	}

	.pagefind-ui__result:last-of-type {
		border-bottom: 0;
	}

	.pagefind-ui__result-nested .pagefind-ui__result-link:before {
		font-family: system-ui;
	}
}
</style>
