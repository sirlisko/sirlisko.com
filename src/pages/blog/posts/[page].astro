---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BackLink from "../../../components/blog/BackLink.astro";
import Main from "../../../components/blog/Main.astro";
import Pagination from "../../../components/blog/Pagination.astro";
import PostCard from "../../../components/blog/PostCard.astro";
import { AUTHOR, BLOG } from "../../../config";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { type Post, publishedPosts } from "../../../lib/blog/posts";

// Page 1 would repeat the blog home, so netlify.toml redirects /blog/posts there instead.
export const getStaticPaths = (async ({ paginate }) =>
	paginate(publishedPosts(await getCollection("posts")), {
		pageSize: BLOG.perPage,
	}).slice(1)) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BlogLayout
	title={`Posts – Page ${page.currentPage}`}
	description={`Older posts on ${AUTHOR.name}'s blog about code, travel, long walks and games. Page ${page.currentPage} of ${page.lastPage}.`}
	footerNoMarginTop={page.lastPage > 1}
>
	<BackLink href="/blog" label="/blog" />
	<Main title="Posts" description="All the articles I've posted.">
		<ul>
			{page.data.map((post: Post) => <PostCard {post} />)}
		</ul>
	</Main>
	<Pagination {page} firstPageUrl="/blog" />
</BlogLayout>
