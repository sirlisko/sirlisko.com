---
import { getCollection } from "astro:content";
import AuthorCard from "../../components/blog/AuthorCard.astro";
import KindIcon from "../../components/blog/KindIcon.astro";
import PostCard from "../../components/blog/PostCard.astro";
import PostIndex from "../../components/blog/PostIndex.astro";
import { AUTHOR, BLOG, SITE_URL } from "../../config";
import IconRss from "../../images/blog/rss.svg";
import IconSearch from "../../images/blog/search.svg";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { publishedPosts } from "../../lib/blog/posts";

const posts = publishedPosts(await getCollection("posts"));
const latest = posts.slice(0, BLOG.latest);
const rest = posts.slice(BLOG.latest);

const INTRO =
	"Mostly code, with travel, long walks, games and the odd bad decision in between. Written from London.";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Blog",
	"@id": `${BLOG.url}#blog`,
	name: BLOG.title,
	description: BLOG.description,
	url: BLOG.url,
	author: { "@id": AUTHOR.id },
	publisher: { "@id": AUTHOR.id },
	isPartOf: { "@id": `${SITE_URL}/#website` },
};
---

<BlogLayout title="Blog" description={`${AUTHOR.name}'s blog. ${INTRO}`}>
	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(structuredData)}
	/>
	<main id="main-content" class="app-layout h-feed" data-back-url="/blog">
		<data class="p-name" value={BLOG.title}></data>
		<AuthorCard />
		<section class="hero">
			<div class="heading">
				<h1 class="pixel-title">/blog</h1>
				<script is:inline>
				// The boot scroll plays on the first visit of a session, like powering on.
				try {
					if (!sessionStorage.getItem("booted")) {
						sessionStorage.setItem("booted", "1");
						document.currentScript.previousElementSibling.classList.add("boot");
					}
				} catch {}
				</script>
				<p class="shortcuts">
					<a
						href="/blog/search"
						class="pixel-icon"
						aria-label="Search"
						title="Search"
					>
						<IconSearch aria-hidden="true" />
					</a>
					<a
						href="/blog/rss.xml"
						class="pixel-icon"
						aria-label="RSS feed"
						title="RSS feed"
						data-track="rss-feed"
						data-astro-reload
					>
						<IconRss aria-hidden="true" />
					</a>
				</p>
			</div>
			{/* The same words as INTRO, keyed to the archive's icons. */}
			<p class="intro">
				Mostly <span><KindIcon kind="code" />code</span>, with{" "}
				<span><KindIcon kind="travel" />travel</span>,{" "}
				<span><KindIcon kind="walk" />long walks</span>,{" "}
				<span><KindIcon kind="game" />games</span>
				<br>
				and <span><KindIcon kind="life" />the odd bad decision</span> in
				between. Written from London.
			</p>
		</section>

		<div aria-hidden="true" class="pixel-rule"></div>

		{posts.length > 0 && (
			<section class="list">
				<h2 class="pixel-label">Latest</h2>
				<ul>
					{latest.map((post) => (
						<PostCard {post} heading="h3" />
					))}
				</ul>
			</section>
		)}

		{rest.length > 0 && (
			<section class="list">
				<h2 class="pixel-label">Every other post</h2>
				<PostIndex posts={rest} level={3} />
			</section>
		)}
	</main>
</BlogLayout>

<style>
.hero {
	display: flex;
	flex-direction: column;
	gap: 1.25rem;
	padding-block: 1rem 2rem;

	@media (min-width: 640px) {
		padding-top: 1.5rem;
	}
}

h1 {
	--boot-window: 1.5rem;
	font-size: 44px;

	@media (min-width: 640px) {
		--boot-window: 8rem;
		font-size: 64px;
	}
}

.intro {
	max-width: 62ch;

	/* Each icon stays on the line of the word it keys. */
	> span {
		white-space: nowrap;
	}

	:global(.kind-icon) {
		display: inline-block;
		margin-inline-end: 0.4ch;
		vertical-align: -1px;
	}
}

/* On the narrowest phones the icons drop under the title, still on the right. */
.heading {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	column-gap: 1rem;
}

/* Pulled into the gutter so the icons, not their hit areas, line up with the column's edge. */
.shortcuts {
	display: flex;
	gap: 0.5rem;
	margin: 0 -10px 0 auto;
}

.list {
	padding-top: 2rem;

	h2 {
		font-size: 0.875rem;
		line-height: 1.25rem;
	}
}
</style>
