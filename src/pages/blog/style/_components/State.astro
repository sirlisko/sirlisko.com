---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<figure class="not-prose">
	<slot />
	<figcaption>{label}</figcaption>
</figure>

<style>
figure {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 0.5rem;
	margin-block: 0;
}

figcaption {
	font-size: 0.75rem;
	line-height: 1rem;
	color: var(--muted-foreground);
}
</style>
