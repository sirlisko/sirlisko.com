---
import { getCollection } from "astro:content";
import { SOURCE } from "../../../../../data/credits";
import AdjacentPostNav from "../../../../components/blog/AdjacentPostNav.astro";
import ReplyByEmail from "../../../../components/blog/ReplyByEmail.astro";
import Webmentions from "../../../../components/blog/Webmentions.astro";
import { postUrl, publishedPosts } from "../../../../lib/blog/posts";
import Specimen from "./Specimen.astro";
import Specimens from "./Specimens.astro";

// No outside avatars here: one is the site's own, the other shows the fallback.
const MENTIONS = [
	{
		"wm-property": "like-of",
		url: "https://example.com/like",
		author: { name: "Luca", photo: "/images/avatar.png" },
	},
	{
		"wm-property": "like-of",
		url: "https://example.org/like",
		author: { name: "Someone without an avatar" },
	},
	{
		"wm-property": "repost-of",
		url: "https://example.com/repost",
		author: { name: "Luca", photo: "/images/avatar.png" },
	},
	{
		"wm-property": "in-reply-to",
		url: "https://example.com/reply",
		published: "2026-10-18T10:00:00Z",
		author: { name: "Luca", photo: "/images/avatar.png" },
		content: {
			text: "A reply from the fediverse or another blog, shortened after 280 characters.",
		},
	},
];

const [newer, older] = publishedPosts(await getCollection("posts")).map(
	(post) => ({
		url: postUrl(post),
		title: post.data.title,
	}),
);
---

<Specimens>
	<Specimen name="<ReplyByEmail>">
		<div class="not-prose flush">
			<ReplyByEmail
				title="Style"
				prompt="Spotted something off on this page?"
				editUrl={`${SOURCE}/edit/main/src/pages/blog/style/_content.mdx`}
			/>
		</div>
	</Specimen>
	<Specimen name="<Webmentions>">
		<div class="not-prose flush">
			<Webmentions target="https://sirlisko.com/blog/style" sample={MENTIONS} />
		</div>
	</Specimen>
	{newer && older && (
		<Specimen name="<AdjacentPostNav>">
			<div class="not-prose flush">
				<AdjacentPostNav {newer} {older} />
			</div>
		</Specimen>
	)}
</Specimens>

<style>
.flush > :global(*) {
	margin-block: 0;
}
</style>
