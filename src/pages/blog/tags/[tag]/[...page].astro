---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BackLink from "../../../../components/blog/BackLink.astro";
import Main from "../../../../components/blog/Main.astro";
import Pagination from "../../../../components/blog/Pagination.astro";
import PostCard from "../../../../components/blog/PostCard.astro";
import { AUTHOR, BLOG } from "../../../../config";
import BlogLayout from "../../../../layouts/BlogLayout.astro";
import {
	hasTag,
	type Post,
	publishedPosts,
	tagsOf,
} from "../../../../lib/blog/posts";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = publishedPosts(await getCollection("posts"));
	return tagsOf(posts).flatMap(({ slug, name }) =>
		paginate(
			posts.filter((post) => hasTag(post, slug)),
			{ params: { tag: slug }, props: { name }, pageSize: BLOG.perPage },
		),
	);
}) satisfies GetStaticPaths;

const { page, name } = Astro.props;

const count = `${page.total} ${page.total === 1 ? "post" : "posts"}`;
const suffix = page.currentPage > 1 ? ` – Page ${page.currentPage}` : "";
const pageOf = suffix && ` Page ${page.currentPage} of ${page.lastPage}.`;
---

<BlogLayout
	title={`Tag: ${name}${suffix}`}
	description={`${count} tagged "${name}" on ${AUTHOR.name}'s blog, newest first.${pageOf}`}
	footerNoMarginTop={page.lastPage > 1}
>
	<BackLink href="/blog/tags" label="/tags" />
	<Main
		title={`/tags/${name}`}
		description={`All the articles with the tag "${name}".`}
	>
		<ul>
			{page.data.map((post: Post) => <PostCard {post} />)}
		</ul>
	</Main>
	<Pagination {page} />
</BlogLayout>
