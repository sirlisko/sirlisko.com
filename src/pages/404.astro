---
import { Image } from "astro:assets";
import Links from "../components/Links.astro";
import me_face from "../images/me.webp";
import Layout from "../layouts/Layout.astro";

const path = Astro.url.pathname;
---

<Layout title="404: Not found" description="This page does not exist." noindex>
	<Links inverted />
	<main class="page">
		<a href="/" class="face-link">
			<Image
				src={me_face}
				alt="sirlisko face"
				width={60}
				height={86}
				densities={[1, 2]}
				transition:name="face"
			/>
		</a>

		<div class="terminal">
			<div class="term-bar">
				<span class="dot r"></span>
				<span class="dot y"></span>
				<span class="dot g"></span>
				<span class="term-bar-title">luca@sirlisko — 404</span>
			</div>
			<div class="term-body">
				<p class="line"><span class="prompt">&#10095;</span> cd {path}</p>
				<p class="error">404: NOT FOUND</p>
				<p class="line muted">this route wandered off into the void.</p>
				<p class="line">
					<span class="prompt">&#10095;</span>
					<a href="/">cd ~</a><span class="cursor"></span>
				</p>
			</div>
		</div>
	</main>
	<script>
	window.umami?.track("404", { url: window.location.pathname });
	</script>
</Layout>

<style>
body {
	background: var(--bg);
	color: var(--text);
}

.page {
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 6rem 1.5rem 4rem;
	gap: 2.5rem;
}

.terminal {
	width: 100%;
	max-width: 560px;
	background: #04090f;
	border: 1px solid var(--border);
	overflow: hidden;
	animation: fadeUp 0.4s ease both;
}

.term-bar {
	background: #16161d;
	border-bottom: 1px solid var(--border);
}

.term-bar-title {
	font-size: 9px;
	color: var(--muted);
	margin-left: 0.5rem;
}

.term-body {
	padding: 1.75rem 1.5rem 2rem;
	font-size: 13px;
	line-height: 1.8;
}

.line {
	margin: 0 0 0.5rem;
	word-break: break-all;
}
.line.muted {
	color: var(--muted);
	font-style: italic;
}

.prompt {
	color: var(--blue);
	margin-right: 0.5rem;
}

.error {
	font-family: var(--font-display);
	font-size: clamp(16px, 4vw, 22px);
	color: #ff5f57;
	text-shadow: 0 0 12px rgba(255, 95, 87, 0.45);
	letter-spacing: 0.05em;
	margin: 1.25rem 0;
}

.term-body a {
	color: var(--blue);
	text-decoration: none;
}
.term-body a:hover {
	text-decoration: underline;
}

.cursor {
	display: inline-block;
	width: 8px;
	height: 1em;
	background: var(--blue);
	vertical-align: middle;
	margin-left: 4px;
	animation: blink 1s step-end infinite;
}
</style>
