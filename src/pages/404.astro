---
import "@fontsource/ibm-plex-mono/latin-400.css";
import Layout from "../layouts/Layout.astro";

const path = Astro.url.pathname;
const LIVES = 3;
---

<Layout
	title="404: Not found"
	description="This page does not exist."
	noindex
	theme="dark"
	themeColor="#000"
>
	<main class="page">
		<div class="lives" aria-hidden="true">
			{Array.from({ length: LIVES }, () => <span class="heart" />)}
		</div>

		<div class="message">
			<h1>Game over</h1>
			<p>
				There's no page at <span class="path">{path}</span>. It may have moved,
				or the link has a typo.
			</p>
		</div>

		<div class="continue">
			<p class="prompt" id="continue">Continue?</p>
			<nav class="menu" aria-labelledby="continue">
				<a class="on" href="/">Go home</a>
				<a href="/projects">See projects</a>
				<a href="/blog" data-astro-reload>Read the blog</a>
			</nav>
		</div>
	</main>
	<script>
	document.addEventListener("astro:page-load", () => {
		window.umami?.track("404", { url: window.location.pathname });
	});
	</script>
</Layout>

<style>
body.dark {
	background: #000;
	padding: 0;
}

.page {
	min-height: 100dvh;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 3rem;
	padding: 3rem 1.5rem;
	color: var(--white);
}

.lives {
	display: flex;
	gap: 8px;
	opacity: 0.3;
	filter: grayscale(1);
}

.heart {
	width: 40px;
	height: 36px;
	background: url(/images/heart.webp) center / contain no-repeat;
	image-rendering: pixelated;
}

.message {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1.25rem;
	text-align: center;
}

h1 {
	margin: 0;
	font-weight: 400;
	font-size: 48px;
	line-height: 1.2;
	color: #ff4d55;

	@media (max-width: 600px) {
		font-size: 32px;
	}
}

.message p {
	margin: 0;
	max-width: 60ch;
	font-family: var(--font-mono);
	font-size: 18px;
	line-height: 1.6;
	overflow-wrap: anywhere;
}

.path {
	color: #ff4d55;
}

.continue {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.prompt {
	margin: 0;
	color: var(--yellow);
}

.menu {
	display: flex;
	flex-direction: column;

	a {
		display: flex;
		align-items: center;
		gap: 16px;
		min-height: 44px;
		color: var(--white);
		text-decoration: none;

		&::before {
			content: "";
			width: 20px;
			height: 18px;
			flex-shrink: 0;
			background: url(/images/heart.webp) center / contain no-repeat;
			image-rendering: pixelated;
			visibility: hidden;
		}

		&:hover::before,
		&:focus-visible::before,
		&.on::before {
			visibility: visible;
		}

		&:focus-visible {
			outline: 3px solid var(--white);
			outline-offset: 4px;
		}
	}

	/* The default pick steps aside while the pointer is choosing another one. */
	&:hover a.on:not(:hover)::before,
	&:focus-within a.on:not(:focus)::before {
		visibility: hidden;
	}
}
</style>
