---
import "../styles/404.css";

import Links from "../components/Links.astro";
import Layout from "../layouts/Layout.astro";

const path = Astro.url.pathname;
---

<Layout title="404: Not found" description="This page does not exist." noindex>
	<Links inverted />
	<main class="page">
		<a href="/" class="face-link">
			<img
				src="/images/me.webp"
				alt="sirlisko face"
				width={60}
				height={86}
				transition:name="face"
			>
		</a>

		<div class="terminal">
			<div class="term-bar">
				<span class="dot r"></span>
				<span class="dot y"></span>
				<span class="dot g"></span>
				<span class="term-bar-title">luca@sirlisko — 404</span>
			</div>
			<div class="term-body">
				<p class="line"><span class="prompt">&#10095;</span> cd {path}</p>
				<p class="error">404: NOT FOUND</p>
				<p class="line muted">this route wandered off into the void.</p>
				<p class="line">
					<span class="prompt">&#10095;</span>
					<a href="/">cd ~</a><span class="cursor"></span>
				</p>
			</div>
		</div>
	</main>
	<script>
	window.umami?.track("404", { url: window.location.pathname });
	</script>
</Layout>
