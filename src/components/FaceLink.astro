---
import { Image } from "astro:assets";
import me_face from "../images/me.webp";

interface Props {
	width?: number;
}

const { width = 60 } = Astro.props;
---

<a href="/" class="face-link" aria-label="Home">
	<Image
		src={me_face}
		alt=""
		class="face-img"
		width={width}
		densities={[1, 2]}
		transition:name="face"
	/>
</a>
