---
import type { UsesItem } from "../../data/uses";

interface Props {
	items: UsesItem[];
}

const { items } = Astro.props;
---

<ul class="uses-list">
	{items.map((item) => (
		<li class="uses-item">
			<span class="emoji" aria-hidden="true">{item.emoji}</span>
			<div class="uses-body">
				<p class="category">{item.category}</p>
				<p class="apps">
					{item.apps.map((app, i) => (
						<>
							{i > 0 && <span class="sep"> / </span>}
							{app.url ? (
								<a href={app.url} target="_blank" rel="noopener noreferrer">{app.name}</a>
							) : (
								<span>{app.name}</span>
							)}
						</>
					))}
				</p>
				{item.note && <p class="note">{item.note}</p>}
			</div>
		</li>
	))}
</ul>

<style>
.uses-list {
	list-style: none;
	margin: 0 0 3rem;
	padding: 0;
	animation: fadeUp 0.4s ease 0.06s both;

	&:last-of-type {
		margin-bottom: 0;
	}
}

.uses-item {
	display: flex;
	align-items: flex-start;
	gap: 1rem;
	margin-bottom: 1.7rem;
}

.emoji {
	font-size: 1.4rem;
	line-height: 1.5;
	width: 1.6rem;
	flex-shrink: 0;
	text-align: center;
}

.uses-body {
	min-width: 0;
}

.category {
	margin: 0 0 0.2rem;
	font-size: 10.5px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: var(--muted);
}

.apps {
	margin: 0;
	font-size: 16px;
	line-height: 1.6;

	a {
		color: var(--white);
		font-weight: 600;
		text-decoration: none;
		background-image: linear-gradient(var(--yellow), var(--yellow));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 1px;
		transition:
			background-size 0.15s ease,
			color 0.15s ease;

		&:hover {
			color: var(--yellow);
			background-size: 100% 1px;
		}
	}
}

.sep {
	color: var(--muted);
	font-weight: 400;
	margin: 0 0.15rem;
}

.note {
	margin: 0.35rem 0 0;
	font-size: 13px;
	color: #9a9aac;
	line-height: 1.65;
}
</style>
