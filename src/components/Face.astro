---
import { Image, type LocalImageProps } from "astro:assets";
import me_face from "../images/me.webp";

// Distributed, since a plain Omit flattens the widths-or-densities union Image's props are built from.
type WithoutSource<T> = T extends unknown ? Omit<T, "src" | "alt"> : never;

type Props = WithoutSource<LocalImageProps> & {
	alt?: string;
};

const { alt = "", class: className, ...rest } = Astro.props;
---

<!-- Every page's face shares this name, so it morphs from one page to the next. -->
<Image
	src={me_face}
	alt={alt}
	class:list={["face-img", className]}
	transition:name="face"
	{...rest}
/>
