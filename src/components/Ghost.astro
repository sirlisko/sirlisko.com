---
const LIVES = 3;
---

<section class="life" aria-hidden="true">
	{Array.from({ length: LIVES }, () => <span class="heart" data-ghost-heart />)}
	<div class="life-label" data-ghost-gameover hidden>
		<p>-Game Over-</p>
		<!-- Out of the tab order: the whole game sits in an aria-hidden, mouse-only section. -->
		<button type="button" class="continue" tabindex="-1" data-ghost-continue>
			Continue?
		</button>
	</div>
	<p class="one-up" data-ghost-oneup>1UP</p>
</section>
<figure class="ghost" aria-hidden="true" data-ghost-sprite></figure>

<script>
import { initGhost } from "../lib/ghost";

let cleanup: (() => void) | undefined;

document.addEventListener("astro:page-load", () => {
	cleanup?.();
	cleanup = initGhost(document);
});
</script>

<style>
.ghost {
	background: transparent url(/images/ghost.webp);
	background-size: contain;
	top: -125px;
	height: 125px;
	left: -125px;
	opacity: 0.5;
	perspective: 800px;
	position: absolute;
	transform-style: preserve-3d;
	transition:
		left 7s,
		top 7s,
		transform 1s;
	width: 125px;
	margin: 0;
	&:hover {
		opacity: 1;
	}
	@media screen and (max-width: 650px) {
		display: none;
	}
}
.ghost.flipped {
	transform: rotateY(180deg);
}

/* Above the ghost, which follows the cursor and would otherwise sit on Continue. */
.life {
	position: absolute;
	z-index: 1;
	left: 1rem;
	top: 1rem;
	text-transform: uppercase;
	@media screen and (max-width: 650px) {
		display: none;
	}
}
.life-label {
	position: absolute;
	top: 0;
	transition: opacity 2s ease;
	white-space: nowrap;
	margin: 0;

	p {
		margin: 0;
	}
}
.continue {
	margin-top: 0.75rem;
	padding: 0;
	font: inherit;
	text-transform: inherit;
	color: inherit;
	background: none;
	border: 0;
	cursor: pointer;
	animation: blink 1s step-end infinite;

	&:hover {
		animation: none;
		text-decoration: underline;
	}
}
.heart {
	background: url(/images/heart.webp);
	background-size: contain;
	display: inline-block;
	height: 45px;
	margin-right: 0.5rem;
	transition: opacity 0.5s ease;
	width: 50px;
}
.one-up {
	position: absolute;
	top: 50%;
	left: calc(100% + 0.5rem);
	margin: 0;
	translate: 0 -50%;
	color: #fff;
	text-shadow: 2px 2px 0 #000;
	white-space: nowrap;
	opacity: 0;

	&.flash {
		animation: one-up 1.6s forwards;
	}
}

@keyframes one-up {
	0%,
	20%,
	40% {
		opacity: 1;
		animation-timing-function: step-end;
	}
	10%,
	30% {
		opacity: 0;
		animation-timing-function: step-end;
	}
	70% {
		opacity: 1;
		translate: 0 -50%;
	}
	100% {
		opacity: 0;
		translate: 0 -150%;
	}
}

.heart[hidden],
.life-label[hidden] {
	display: none;
}

/* The ghost only exists to chase the cursor, so there is nothing left to show. */
@media (prefers-reduced-motion: reduce) {
	.ghost,
	.life {
		display: none;
	}
}
</style>
