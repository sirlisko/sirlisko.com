---
import type { UsesApp } from "../../../data/uses";

interface Props {
	apps: UsesApp[];
}

const { apps } = Astro.props;
---

{apps.map((app, i) => (
	<>
		{i > 0 && <span class="sep">, </span>}
		{app.url ? <a href={app.url} target="_blank" rel="noopener noreferrer">{app.name}</a> : app.name}
	</>
))}

<style>
.sep {
	color: var(--snazzy-dim);
	font-weight: 400;
}

a {
	color: inherit;
	text-decoration: none;

	&:hover {
		color: var(--snazzy-yellow);
		text-decoration: underline;
	}

	&:focus-visible {
		outline: 2px solid var(--snazzy-yellow);
		outline-offset: 2px;
	}
}
</style>
