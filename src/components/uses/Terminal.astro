---
interface Props {
	title: string;
	/** The Infocom status line: where you are and how many moves it took. */
	location: string;
	moves: number;
}

const { title, location, moves } = Astro.props;
---

<div class="term">
	<div class="term-bar">
		<span class="dot r"></span>
		<span class="dot y"></span>
		<span class="dot g"></span>
		<span class="term-title">{title}</span>
	</div>
	<p class="status">
		<span>{location}</span>
		<span>Moves: {moves}</span>
	</p>
	<div class="screen">
		<slot />
	</div>
</div>

<style>
/* Snazzy, the iTerm2 theme this all actually runs in. */
.term {
	--snazzy-bg: #282a36;
	--snazzy-fg: #eff0eb;
	--snazzy-green: #5af78e;
	--snazzy-yellow: #f3f99d;
	--snazzy-blue: #57c7ff;
	--snazzy-magenta: #ff6ac1;
	--snazzy-cyan: #9aedfe;
	--snazzy-dim: #9799a8;
	background: var(--snazzy-bg);
	color: var(--snazzy-fg);
	border: 1px solid #3a3c4a;
	border-radius: 10px;
	overflow: hidden;
	box-shadow: 0 30px 80px -30px #000;
}

.term-bar {
	position: relative;
	display: flex;
	align-items: center;
	gap: 0.45rem;
	padding: 0.55rem 1rem;
	background: #1f2029;
}

.dot {
	width: 10px;
	height: 10px;
	border-radius: 50%;
}

.r {
	background: #ff5f57;
}

.y {
	background: #febc2e;
}

.g {
	background: #28c840;
}

.term-title {
	position: absolute;
	inset: 0;
	display: grid;
	place-items: center;
	font-size: 12px;
	color: var(--snazzy-dim);
	pointer-events: none;
}

.status {
	display: flex;
	justify-content: space-between;
	gap: 1rem;
	margin: 0;
	padding: 0.2rem clamp(1rem, 3vw, 1.75rem);
	background: var(--snazzy-fg);
	color: var(--snazzy-bg);
	font-size: 15px;
	font-weight: 600;
}

.screen {
	padding: 1.25rem clamp(1rem, 3vw, 1.75rem) 1.5rem;
	font-size: 15px;
	line-height: 1.6;
}
</style>
