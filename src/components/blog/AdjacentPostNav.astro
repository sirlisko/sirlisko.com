---
interface Adjacent {
	url: string;
	title: string;
}

/** Lists run newest first, so the newer post sits on the left, like going back. */
interface Props {
	newer: Adjacent | null;
	older: Adjacent | null;
}

const { newer, older } = Astro.props;
---

<div data-pagefind-ignore class="adjacent">
	{newer && (
		<a href={newer.url}>
			<span class="pixel-label direction">
				<span aria-hidden="true" class="pixel-arrow back"></span>
				Newer
			</span>
			<span class="title">{newer.title}</span>
		</a>
	)}
	{older && (
		<a href={older.url} class="older">
			<span class="pixel-label direction">
				Older
				<span aria-hidden="true" class="pixel-arrow"></span>
			</span>
			<span class="title">{older.title}</span>
		</a>
	)}
</div>

<style>
.adjacent {
	display: grid;
	gap: 1.5rem;
	margin-block: 2rem;

	@media (min-width: 640px) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

a {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;

	&:hover {
		opacity: 0.75;
	}
}

.older {
	text-align: end;

	@media (min-width: 640px) {
		grid-column-start: 2;
	}

	.direction {
		justify-content: flex-end;
	}
}

.direction {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	font-size: 11px;
}

.title {
	font-weight: 600;
}
</style>
