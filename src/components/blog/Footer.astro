---
import me from "../../../data/me";
import Webring from "./Webring.astro";

interface Props {
	/** Leaves room for the back-to-top button, fixed in the corner on phones. */
	clearBackToTop?: boolean;
}

const { clearBackToTop = false } = Astro.props;

const links = [
	{ label: "tags", href: "/blog/tags" },
	{ label: "search", href: "/blog/search" },
	{ label: "rss", href: "/blog/rss.xml", track: "rss-feed", reload: true },
	{ label: "mail", href: `mailto:${me.email}`, track: "social-mail" },
	{ label: "style", href: "/blog/style" },
];
---

<footer class:list={["app-layout", { "clear-back-to-top": clearBackToTop }]}>
	<div class="bar">
		<nav aria-label="Blog">
			<ul>
				{links.map(({ label, href, track, reload }) => (
					<li>
						<a
							href={href}
							class="menu-cursor"
							data-track={track}
							data-astro-reload={reload}>{label}</a
						>
					</li>
				))}
			</ul>
		</nav>
		<div class="fine-print">
			<p>
				&#169; {new Date().getFullYear()} Luca Lischetti,{" "}
				<a href="https://creativecommons.org/licenses/by/4.0/" rel="license"
					>CC BY 4.0</a
				>
			</p>
			<Webring />
		</div>
	</div>
</footer>

<style>
footer {
	margin-top: auto;
}

.clear-back-to-top {
	@media (max-width: 767px) {
		padding-bottom: 6rem;
	}
}

/* The same dashed rule as the Paused menu, so the two read as one system. */
.bar {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
	margin-top: 2rem;
	padding-block: 1rem 1.5rem;
	border-top: 2px dashed var(--blog-accent);
}

/* Three a row on phones, so no link is left alone on the second one. */
ul {
	display: grid;
	grid-template-columns: repeat(3, auto);
	justify-content: center;
	column-gap: 1.5rem;
	font-family: var(--font-pixel);
	font-size: 12px;

	@media (min-width: 640px) {
		display: flex;
		justify-content: start;
	}
}

li {
	text-align: center;
}

a.menu-cursor {
	display: inline-flex;
	min-height: 44px;
	align-items: center;

	&::before {
		top: calc(50% - 7px);
	}

	&:is(:hover, :focus-visible) {
		color: var(--accent);
	}
}

.fine-print {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.75rem;
	font-family: var(--font-pixel);
	font-size: 10px;
	line-height: 1.6;
	color: var(--muted-foreground);

	@media (min-width: 640px) {
		flex-direction: row;
		justify-content: space-between;
	}

	a[rel="license"] {
		text-decoration: underline;
		text-underline-offset: 3px;

		&:is(:hover, :focus-visible) {
			color: var(--foreground);
		}
	}
}
</style>
