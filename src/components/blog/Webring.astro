---
const RING = "https://xn--sr8hvo.ws";
---

{/* The ring knows the blog by its exact URL, so the links send the full referrer. */}
<nav class="webring" aria-label="IndieWeb Webring">
	<a
		href={`${RING}/previous`}
		referrerpolicy="no-referrer-when-downgrade"
		aria-label="Previous site in the IndieWeb Webring"
		><span aria-hidden="true" class="pixel-arrow back"></span></a
	>
	<a href={RING} title="An IndieWeb Webring">🕸💍</a>
	<a
		href={`${RING}/next`}
		referrerpolicy="no-referrer-when-downgrade"
		aria-label="Next site in the IndieWeb Webring"
		><span aria-hidden="true" class="pixel-arrow"></span></a
	>
</nav>

<style>
.webring {
	display: flex;
	align-items: center;
	font-size: 12px;

	a {
		display: inline-flex;
		min-width: 32px;
		min-height: 32px;
		align-items: center;
		justify-content: center;
	}

	a:is(:hover, :focus-visible) {
		color: var(--foreground);
	}
}
</style>
