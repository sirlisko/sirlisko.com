---
interface Props {
	href: string;
	label: string;
	/** Posts go back to whichever list the reader came from, not always to /blog. */
	remembered?: boolean;
}

const { href, label, remembered = false } = Astro.props;
---

<nav class="app-layout" aria-label="breadcrumb">
	<a
		href={href}
		class="back-link"
		data-remembered-back={remembered || undefined}
	>
		<span aria-hidden="true" class="pixel-arrow back"></span>
		<span data-back-label>{label}</span>
	</a>
</nav>

<script>
import { backLabel, recallBackUrl } from "../../lib/blog/backUrl";

document.addEventListener("astro:page-load", () => {
	const link = document.querySelector<HTMLAnchorElement>(
		"[data-remembered-back]",
	);
	const url = recallBackUrl();
	const text = link?.querySelector("[data-back-label]");
	if (link && text && url) {
		link.href = url;
		text.textContent = backLabel(url);
	}
});
</script>
