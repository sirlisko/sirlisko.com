---
import IconRss from "../../images/blog/rss.svg";
import IconSearch from "../../images/blog/search.svg";
import FaceLink from "../FaceLink.astro";
import Links from "../Links.astro";
---

<a id="skip-to-content" href="#main-content" class="skip-link"
	>Skip to content</a
>

<!-- The face and menu are pinned like on every page; this keeps their room in the flow. -->
<header class="site-header">
	<FaceLink />
	<Links page="blog">
		<div slot="pause" class="pause-extras">
			<a href="/blog/tags">tags</a>
			<a href="/blog/archives">archives</a>
			<a href="/blog/search" class="pixel-icon" aria-label="Search">
				<IconSearch aria-hidden="true" />
			</a>
			<a
				href="/blog/rss.xml"
				class="pixel-icon"
				aria-label="RSS feed"
				data-track="rss-feed"
				data-astro-reload
			>
				<IconRss aria-hidden="true" />
			</a>
		</div>
	</Links>
</header>

<style>
.site-header {
	position: relative;
	height: 117px;
}

.skip-link {
	position: absolute;
	top: -100%;
	left: 4rem;
	z-index: 50;
	padding: 0.5rem 0.75rem;
	background: var(--background);
	color: var(--accent);

	&:focus {
		top: 1rem;
	}
}

.pause-extras {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	margin-bottom: 1.5rem;
	padding-top: 1rem;
	border-top: 2px dashed var(--blog-accent);
	font-family: var(--font-app);
	font-size: 15px;

	> a:not(.pixel-icon) {
		padding: 0.625rem 0.5rem;
	}

	.pixel-icon {
		color: var(--background);

		&:hover {
			color: var(--pea);
		}
	}
}
</style>

<script>
// The router would land on #main-content without moving focus there.
document.addEventListener("astro:page-load", () => {
	document.getElementById("skip-to-content")?.addEventListener("click", (e) => {
		const target = document.getElementById("main-content");
		if (!target || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) {
			return;
		}
		e.preventDefault();
		target.setAttribute("tabindex", "-1");
		target.addEventListener("blur", () => target.removeAttribute("tabindex"), {
			once: true,
		});
		target.focus();
		target.scrollIntoView({ behavior: "smooth" });
	});
});
</script>
