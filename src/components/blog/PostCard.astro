---
import { postKind } from "../../lib/blog/kind";
import { type Post, postUrl } from "../../lib/blog/posts";
import KindIcon from "./KindIcon.astro";
import NotLiveBadge from "./NotLiveBadge.astro";
import PostDate from "./PostDate.astro";

interface Props {
	post: Post;
	heading?: "h2" | "h3";
}

const { post, heading: Heading = "h2" } = Astro.props;
const { title, description, pubDatetime, modDatetime, timezone, bump } =
	post.data;
---

<li class="card h-entry">
	<div class="meta">
		<KindIcon kind={postKind(post)} />
		<PostDate {pubDatetime} {modDatetime} {timezone} {bump} />
	</div>
	<NotLiveBadge {post} />
	<a href={postUrl(post)} class="title menu-cursor u-url" data-menu-item>
		<Heading class="p-name" transition:name={`post-${post.id}`}
			>{title}</Heading
		>
	</a>
	<p class="description p-summary">{description}</p>
</li>

<style>
.card {
	display: flex;
	flex-direction: column;
	gap: 0.25rem;
	margin-block: 2rem;
}

.meta {
	display: flex;
	align-items: center;
	gap: 0.625rem;
}

.title {
	display: inline-block;
	font-size: 19px;
	font-weight: 600;
	line-height: 1.375;
}

.description {
	font-size: 15px;
	color: var(--foreground-soft);
}
</style>
