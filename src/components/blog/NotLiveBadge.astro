---
import { notLive, type Post } from "../../lib/blog/posts";

interface Props {
	post: Pick<Post, "data">;
}

const status = notLive(Astro.props.post);
---

{status && <span class="not-live">{status} · not live</span>}

<style>
.not-live {
	display: block;
	width: fit-content;
	padding: 0 0.375rem;
	border: 1px dashed currentColor;
	font-size: 0.75rem;
	line-height: 1.25rem;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: var(--accent);
}
</style>
