---
import type { MarkdownHeading } from "astro";
import TocList from "./TocList.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

{/* Above the article on narrow screens; pinned in the margin beside it once there's room. */}
<div class="with-contents">
	<details class="inline" data-pagefind-ignore>
		<summary class="pixel-label">
			<span aria-hidden="true" class="pixel-arrow"></span>
			Contents
		</summary>
		<TocList {headings} />
	</details>
	<slot />
	<nav class="margin" aria-label="Contents" data-pagefind-ignore>
		<p class="pixel-label">Contents</p>
		<TocList {headings} />
	</nav>
</div>

<style>
.inline {
	margin-top: 2rem;
	padding: 0.75rem 1rem;
	border: 2px dashed var(--pea);

	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 28px;
		cursor: pointer;
		list-style: none;

		&::-webkit-details-marker {
			display: none;
		}
	}

	&[open] summary {
		margin-bottom: 0.75rem;

		.pixel-arrow {
			rotate: 90deg;
		}
	}

	:global(.toc) {
		padding-inline-start: 1rem;
	}
}

.margin {
	display: none;
}

/* The column is 48rem; the margin list needs 15rem beside it on the right. */
@media (min-width: 1300px) {
	.with-contents {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 12rem;
		column-gap: 3rem;
		margin-inline-end: -15rem;
	}

	.inline {
		display: none;
	}

	.margin {
		position: sticky;
		top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		grid-column: 2;
		grid-row: 1;
		align-self: start;
		max-height: calc(100svh - 4rem);
		overflow-y: auto;
		padding-inline-start: 1rem;
	}
}
</style>
