---
import { BLOG } from "../../config";

interface Props {
	title: string;
	prompt?: string | undefined;
}

const { title, prompt = "Thoughts?" } = Astro.props;

const href = `mailto:${BLOG.replyTo}?subject=${encodeURIComponent(`Re: ${title}`)}`;
---

<p data-pagefind-ignore class="reply">
	{prompt}{" "}
	<a href={href} data-track="reply-email">
		<span aria-hidden="true" class="pixel-arrow"></span>
		<span class="label">Reply via email</span>
	</a>
</p>

<style>
/* The bottom margin matches the tags' top one, so the floated back-to-top button stays level with them. */
.reply {
	margin-bottom: 1rem;
	color: var(--muted-foreground);

	@media (min-width: 640px) {
		margin-bottom: 2rem;
	}
}

a {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	white-space: nowrap;
	color: var(--foreground);

	&:is(:hover, :focus-visible) {
		color: var(--accent);
	}
}

.label {
	text-decoration: underline;
	text-underline-offset: 3px;
}

/* Blinks like a Game Boy menu cursor on the selected option. */
@media (prefers-reduced-motion: no-preference) {
	a:is(:hover, :focus-visible) .pixel-arrow {
		animation: blink 0.8s steps(1) infinite;
	}
}
</style>
