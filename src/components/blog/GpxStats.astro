---
interface Track {
	label?: string | undefined;
	distance?: number | undefined;
	elevGain?: number | undefined;
	duration?: string | undefined;
}

interface Props {
	tracks: Track[];
}

// Each keeps its place among all the tracks, which picks its line on the map.
const withStats = Astro.props.tracks
	.map((t, track) => ({ ...t, track }))
	.filter((t) => t.distance || t.elevGain || t.duration);
const keyed = Astro.props.tracks.length > 1;
const totalDistance = withStats.reduce((sum, t) => sum + (t.distance ?? 0), 0);
const totalGain = withStats.reduce((sum, t) => sum + (t.elevGain ?? 0), 0);
---

{withStats.length > 0 && (
	<div class="stats">
		{withStats.map((t, i) => (
			<div class="row">
				<div class="label">
					{keyed && (
						<svg class="swatch" width="24" height="4" aria-hidden="true">
							<line
								class={`map-track map-track-${t.track % 3}`}
								x1="0"
								y1="2"
								x2="24"
								y2="2"
								stroke-width="3"
							/>
						</svg>
					)}
					{t.label ?? `Day ${i + 1}`}
				</div>
				{t.distance && (
					<div class="stat">
						<span>Distance</span>
						{t.distance.toFixed(1)} km
					</div>
				)}
				{t.elevGain && (
					<div class="stat">
						<span>Elevation</span>+{t.elevGain} m
					</div>
				)}
				{t.duration && (
					<div class="stat">
						<span>Time</span>
						{t.duration}
					</div>
				)}
			</div>
		))}
		{withStats.length > 1 && (
			<div class="row total">
				<div class="label">Total</div>
				<div class="stat">
					<span>Distance</span>
					{totalDistance.toFixed(1)} km
				</div>
				<div class="stat">
					<span>Elevation</span>+{totalGain} m
				</div>
			</div>
		)}
	</div>
)}

<style>
.stats {
	margin-block: 1.5rem;
	border: 1px solid var(--border);
	font-size: 0.875rem;
	line-height: 1.25rem;
}

.row {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 0.5rem;
	padding: 0.75rem 1rem;

	& + & {
		border-top: 1px solid var(--border);
	}
}

.total {
	background: color-mix(in srgb, var(--muted) 40%, transparent);
	font-weight: 500;
}

.label {
	grid-column: span 4;
	font-weight: 500;

	@media (min-width: 640px) {
		grid-column: span 1;
	}
}

.label:has(.swatch) {
	display: flex;
	align-items: start;
	gap: 0.5rem;
}

/* Centred on the first line, which is 1.25rem tall. */
.swatch {
	flex-shrink: 0;
	margin-top: calc(0.625rem - 2px);
}

.stat {
	display: flex;
	flex-direction: column;

	span {
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 400;
		color: var(--muted-foreground);
	}
}
</style>
