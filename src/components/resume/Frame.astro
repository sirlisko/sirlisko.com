---
interface Props {
	title?: string;
	/** The plain heading CV parsers look for, added to the title on paper. */
	printTitle?: string;
	id?: string;
	as?: "section" | "dl";
	class?: string;
}

const {
	title,
	printTitle,
	id,
	as: Tag = "section",
	class: className,
	...rest
} = Astro.props;
---

<Tag
	class:list={["frame", className]}
	aria-labelledby={title ? id : undefined}
	{...rest}
>
	{title && (
		<h2 id={id}>
			{title}
			{printTitle && <span class="print"> · {printTitle}</span>}
		</h2>
	)}
	<slot />
</Tag>

<style>
/*
 * Pixel-stepped corners on a 3px grid, to match the portrait. The edges are a
 * real border so they snap crisply to screen pixels; the corners are painted
 * over it, and a browser that skips backgrounds just gets square corners.
 *
 * Wrapped in :where() so a section's own class can override the spacing
 * without depending on stylesheet order.
 */
:where(.frame) {
	position: relative;
	border: 3px solid var(--ink);
	padding: 1.75rem 1.25rem 1.25rem;
	display: flex;
	flex-direction: column;
	gap: 1rem;
	& :global(ul) {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	&::before {
		--p: linear-gradient(var(--paper) 0 0);
		--i: linear-gradient(var(--ink) 0 0);
		content: "";
		position: absolute;
		inset: -3px;
		pointer-events: none;
		background:
			var(--p) left top / 9px 3px,
			var(--p) left 0 top 3px / 3px 6px,
			var(--i) left 6px top 3px / 3px 3px,
			var(--i) left 3px top 6px / 3px 3px,
			var(--p) right top / 9px 3px,
			var(--p) right 0 top 3px / 3px 6px,
			var(--i) right 6px top 3px / 3px 3px,
			var(--i) right 3px top 6px / 3px 3px,
			var(--p) left bottom / 9px 3px,
			var(--p) left 0 bottom 3px / 3px 6px,
			var(--i) left 6px bottom 3px / 3px 3px,
			var(--i) left 3px bottom 6px / 3px 3px,
			var(--p) right bottom / 9px 3px,
			var(--p) right 0 bottom 3px / 3px 6px,
			var(--i) right 6px bottom 3px / 3px 3px,
			var(--i) right 3px bottom 6px / 3px 3px;
		background-repeat: no-repeat;
	}
	& > h2 {
		position: absolute;
		top: calc(-1.5px - 0.75rem);
		left: 0.5rem;
		padding: 0 0.5rem;
		background: var(--paper);
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1rem;
		line-height: 1.5rem;
		color: var(--blood);
	}
}

/*
 * The print zoom shrinks 3px to a fraction, and the border and each corner
 * patch round on their own, leaving slivers. On paper the frame is one clipped
 * shape instead, the outline then its inner edge, with evenodd leaving the
 * ring between. The border stays, transparent, for the layout.
 */
@media print {
	:where(.frame) {
		padding: 1.5rem 1.25rem 1rem;
		gap: 0.75rem;
		border-color: transparent;
		&::before {
			--r: calc(100% - 3px);
			--s: calc(100% - 6px);
			--t: calc(100% - 9px);
			background: var(--ink);
			clip-path: polygon(
				evenodd,
				9px 0,
				var(--t) 0,
				var(--t) 3px,
				var(--s) 3px,
				var(--s) 6px,
				var(--r) 6px,
				var(--r) 9px,
				100% 9px,
				100% var(--t),
				var(--r) var(--t),
				var(--r) var(--s),
				var(--s) var(--s),
				var(--s) var(--r),
				var(--t) var(--r),
				var(--t) 100%,
				9px 100%,
				9px var(--r),
				6px var(--r),
				6px var(--s),
				3px var(--s),
				3px var(--t),
				0 var(--t),
				0 9px,
				3px 9px,
				3px 6px,
				6px 6px,
				6px 3px,
				9px 3px,
				9px 0,
				9px 3px,
				var(--t) 3px,
				var(--t) 6px,
				var(--s) 6px,
				var(--s) 9px,
				var(--r) 9px,
				var(--r) var(--t),
				var(--s) var(--t),
				var(--s) var(--s),
				var(--t) var(--s),
				var(--t) var(--r),
				9px var(--r),
				9px var(--s),
				6px var(--s),
				6px var(--t),
				3px var(--t),
				3px 9px,
				6px 9px,
				6px 6px,
				9px 6px,
				9px 3px
			);
		}
	}
}
</style>
