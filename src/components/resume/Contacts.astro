---
// The phone number must never reach the public build: only `pnpm generate:cv`
// sets CV_BUILD, so a stray PHONE_NUMBER in a deploy environment stays unused.
const phoneNumber = import.meta.env.CV_BUILD
	? import.meta.env.PHONE_NUMBER
	: undefined;
---

<section class="section contacts">
	<h2>Contacts</h2>
	{phoneNumber && (<p>Phone:{" "}<a href={`tel:${phoneNumber}`}>{phoneNumber}</a></p>)}
	<p>Email:{" "}<a href="mailto:luca@sirlisko.com">luca@sirlisko.com</a>.</p>
	<p>
		Personal website:{" "}<a href="https://sirlisko.com"
			>https://sirlisko.com</a
		>
	</p>
	<p>
		Github:{" "}<a
			href="https://github.com/sirlisko"
			target="_blank"
			rel="noreferrer"
			>https://github.com/sirlisko</a
		>
	</p>
	<p>
		LinkedIn:{" "}<a
			href="https://www.linkedin.com/in/lucalischetti/"
			target="_blank"
			rel="noreferrer"
			style={{display: 'inline-block'}}
			>https://www.linkedin.com/in/lucalischetti/</a
		>
	</p>
	<p class="alt-hidden">
		A print-friendly version of this:{" "}
		{phoneNumber?
			<a
				href="https://sirlisko.com/cv/private-alt.pdf"
				target="_blank"
				rel="noreferrer"
				style={{display: 'inline-block'}}
				>https://sirlisko.com/cv/private-alt.pdf</a
			>
      :
    <a
				href="https://sirlisko.com/cv/alt.pdf"
				target="_blank"
				rel="noreferrer"
				style={{display: 'inline-block'}}
				>https://sirlisko.com/cv/alt.pdf</a
			>}
	</p>
	<p class="alt-visible">
		A live version of this resume:{" "}
		<a href="https://sirlisko.com/resume">https://sirlisko.com/resume</a>
	</p>
</section>
<style is:global>
.alt-visible {
	display: none;
}
.alt .alt-visible {
	display: block;
}
.alt .alt-hidden {
	display: none;
}
</style>
