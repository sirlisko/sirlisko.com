---
import me from "../../../data/me";
import Qr from "../../images/qr-code.svg";

// The phone number must never reach the public build: only `pnpm generate:cv`
// sets CV_BUILD, so a stray PHONE_NUMBER in a deploy environment stays unused.
const phoneNumber = import.meta.env.CV_BUILD
	? import.meta.env.PHONE_NUMBER
	: undefined;

const contacts = [
	["GitHub", "https://github.com/sirlisko"],
	["LinkedIn", "https://linkedin.com/in/lucalischetti/"],
	["Website", "https://sirlisko.com"],
];
---

<footer class="contacts">
	<div class="cta">
		<Qr class="qr print" aria-hidden="true" />
		<p class="screen">
			Prefer a regular CV?{" "}
			<a
				href="/cv/luca-lischetti-resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				>Download the PDF</a
			>
		</p>
		<p class="print">
			Live version:{" "}
			<a href="https://sirlisko.com/resume">sirlisko.com/resume</a>
		</p>
	</div>
	<p class="links">
		{phoneNumber && <a href={`tel:${phoneNumber}`}>{phoneNumber}</a>}
		<a href={`mailto:${me.email}`}>{me.email}</a>
		{contacts.map(([name, url]) => (
			<a href={url}>
				<span class="screen">{name}</span>
				<span class="print">{url.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "")}</span>
			</a>
		))}
	</p>
</footer>

<style>
.contacts {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	gap: 1rem 1.75rem;
	align-items: center;
	border-top: 3px solid var(--ink);
	padding-top: 1.5rem;
	& .cta {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	& .qr {
		width: 6rem;
		height: auto;
		image-rendering: pixelated;
	}
	& .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}
}

/* Room for the phone number on one line in the private PDF. */
@media print {
	.contacts {
		gap: 1rem;
		& .links {
			gap: 0.5rem 1rem;
		}
	}
}
</style>
