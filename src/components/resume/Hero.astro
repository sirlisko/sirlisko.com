---
import { Image } from "astro:assets";
import type { Resume } from "../../../data/resume";
import me_face from "../../images/me.webp";
import Frame from "./Frame.astro";

interface Props {
	stats: Resume["stats"];
}

const { stats } = Astro.props;
---

<header class="hero">
	<a href="/" class="portrait">
		<Image
			src={me_face}
			alt="sirlisko face"
			width={200}
			height={287}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
			transition:name="face"
		/>
	</a>
	<div class="name">
		<h1>Luca Lischetti</h1>
		<p class="label">Character name, a.k.a. sirlisko</p>
	</div>
	<Frame as="dl" class="stats">
		{stats.map(([value, label]) => (
			<div><dd>{value}</dd><dt class="label">{label}</dt></div>
		))}
	</Frame>
</header>

<style>
.hero {
	display: flex;
	flex-wrap: wrap;
	align-items: stretch;
	gap: 1.75rem;
}
.portrait {
	align-self: center;
	& img {
		display: block;
		width: 7rem;
		height: auto;
		image-rendering: pixelated;
	}
}
.name {
	flex: 1 1 18rem;
	display: flex;
	flex-direction: column;
	justify-content: center;
	gap: 0.5rem;
	& h1 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 2rem;
		line-height: 1.4;
	}
	& .label {
		font-size: 0.875rem;
	}
}
.stats {
	flex: 999 1 28rem;
	padding: 1rem;
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	align-content: center;
	gap: 1.1rem 1.75rem;
	& dd {
		padding-bottom: 0.375rem;
		border-bottom: 2px solid var(--ink);
		font-weight: 600;
		line-height: 1.4;
	}
	& dt {
		margin-top: 0.375rem;
	}
	/* Bottom-aligned so a wrapped value doesn't push its row's rules apart. */
	& div {
		display: flex;
		flex-direction: column;
		justify-content: end;
	}
}

@media screen and (max-width: 800px) {
	.name h1 {
		font-size: 1.25rem;
	}
	.stats {
		grid-template-columns: 1fr;
	}
}

@media print {
	.stats {
		padding: 1.5rem 1.25rem 1rem;
		gap: 0.75rem;
	}
}
</style>
