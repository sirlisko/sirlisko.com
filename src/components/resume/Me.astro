---
import { Image } from "astro:assets";
import me_face from "../../images/me.webp";
---

<section class="me">
	<div class="me__face">
		<a href="/">
			<Image
				src={me_face}
				alt="sirlisko face"
				width={200}
				height={287}
				densities={[1, 2]}
				loading="eager"
				fetchpriority="high"
				transition:name="face"
			/></a
		>
	</div>
	<h1 class="me__intro">
		<span>Luca Lischetti</span><span>a.k.a. sirlisko</span
		><span>Senior Software Engineer</span>
	</h1>
</section>
