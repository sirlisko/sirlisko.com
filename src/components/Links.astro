---
import me from "../../data/me";
import { navLinks, type PageName } from "../lib/links";

interface Props {
	page?: PageName;
}

const { page } = Astro.props;

const links = navLinks(me.links, page);
const game = page ?? "home";
const PAUSE_TITLES: Record<typeof game, string> = {
	home: "Paused",
	now: "Ready!",
	projects: "Select",
	uses: "Where to?",
	resume: "Short rest",
	credits: "The end",
	blog: "Paused",
};
---

<nav class="nav" data-game={game} aria-label="Main">
	<ul class="menu">
		{links.map((link) => (
			<li>
				<a
					href={link.url}
					aria-current={link.name === page ? "page" : undefined}>{link.label}</a
				>
			</li>
		))}
	</ul>
	<button type="button" class="start" id="nav-start" aria-haspopup="dialog">
		Start
	</button>
	<dialog class="pause" id="nav-pause" aria-label="Menu">
		<p class="pause-title" aria-hidden="true">{PAUSE_TITLES[game]}</p>
		<ul class="menu">
			{links.map((link) => (
				<li>
				<a
					href={link.url}
					aria-current={link.name === page ? "page" : undefined}
					autofocus={link.name === page}>{link.label}</a
				>
			</li>
			))}
		</ul>
		<slot name="pause" />
		<form method="dialog">
			<button type="submit" class="menu-close">Continue</button>
		</form>
	</dialog>
</nav>

<style>
/* Each page is a different game, so the menu borrows its colours and cursor. */
.nav {
	--fg: #000;
	--accent: #000;
	--pause-bg: #000;
	--pause-fg: #fff;
	--pause-title: var(--nes-yellow);
	--pause-accent: var(--nes-yellow);
	/* Drawn shapes, since the display font lacks ▶ and ✦ and fallback fonts sit them at a different height per platform. */
	--cursor: polygon(0 0, 100% 50%, 0 100%);
	--cursor-width: 0.6em;
	/* Labels are all lowercase, so shapes centred on the em box read high. */
	--cursor-nudge: 0.08em;
	--font: var(--font-display);
	--size: 16px;
	position: absolute;
	top: 1.5rem;
	right: 1.5rem;
	z-index: 10;
	font-family: var(--font);
	/* Pages set their own line-height, so pin it to keep the Start button the same size everywhere, blog included. */
	line-height: 1.7;
}

@media (prefers-color-scheme: dark) {
	.nav[data-game="home"] {
		--fg: var(--home-night-text);
		--accent: rgb(var(--lamp));
	}
}

.nav[data-game="now"] {
	--fg: var(--pac-menu);
	--accent: var(--pac-yellow);
	--pause-title: var(--pac-yellow);
	--pause-accent: var(--pac-yellow);
}

.nav[data-game="projects"] {
	--fg: var(--nes-white);
	--accent: var(--nes-red);
	--pause-accent: var(--nes-red);
}

.nav[data-game="uses"] {
	--fg: var(--snazzy-fg);
	--accent: var(--snazzy-green);
	--pause-bg: var(--snazzy-bg);
	--pause-fg: var(--snazzy-fg);
	--pause-title: var(--snazzy-yellow);
	--pause-accent: var(--snazzy-green);
	--cursor-nudge: 0.15em;
}

.nav[data-game="resume"] {
	--fg: var(--white);
	--accent: var(--blueprint-gold);
	--pause-bg: var(--sheet-paper);
	--pause-fg: var(--sheet-ink);
	--pause-title: var(--sheet-blood);
	--pause-accent: var(--sheet-blood);
	--cursor: polygon(
		50% 0,
		62% 38%,
		100% 50%,
		62% 62%,
		50% 100%,
		38% 62%,
		0 50%,
		38% 38%
	);
	--cursor-width: 0.75em;
}

.nav[data-game="blog"] {
	--fg: var(--foreground);
	--accent: var(--led);
	--pause-bg: var(--foreground);
	--pause-fg: var(--background);
	--pause-title: var(--pea);
	--pause-accent: var(--led);
	/* A round dot has nothing to lean, so it sits dead centre. */
	--cursor-nudge: 0em;
}

.nav[data-game="credits"] {
	--fg: var(--nes-white);
	--accent: var(--nes-yellow);
}

.menu {
	display: flex;
	gap: 2.25rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.menu a {
	position: relative;
	color: var(--fg);
	font-size: var(--size);
	text-decoration: none;

	&::before {
		content: "";
		position: absolute;
		right: calc(100% + 0.5em);
		width: var(--cursor-width);
		height: 0.75em;
		background: var(--accent);
		clip-path: var(--cursor);
		font-size: 0.75em;
		top: 50%;
		translate: 0 calc(-50% + var(--cursor-nudge));
		visibility: hidden;
	}

	&[aria-current]::before {
		visibility: visible;
	}

	&:hover::before,
	&:focus-visible::before {
		visibility: visible;

		@media (prefers-reduced-motion: no-preference) {
			animation: blink 0.8s steps(1) infinite;
		}
	}

	&:focus-visible {
		outline: none;
		color: var(--accent);
	}
}

/* Home's accent is its text colour, so focus needs a mark the cursor alone can't give. */
.nav[data-game="home"] .menu a:focus-visible {
	text-decoration: underline 3px;
	text-underline-offset: 0.4em;
}

/* One cursor at a time: the parked one steps aside while another link is picked. */
.menu:is(:hover, :has(:focus-visible))
a[aria-current]:not(:hover, :focus-visible)::before {
	visibility: hidden;
}

/* The terminal's prompt is in the font, so it stays a glyph. */
.nav[data-game="uses"] .menu a::before {
	content: ">";
	width: auto;
	height: auto;
	background: none;
	clip-path: none;
	color: var(--accent);
	line-height: inherit;
}

/* The screen shows through, darkened, behind the pause menu. */
.nav[data-game="blog"] .pause::backdrop {
	background: rgb(15 56 15 / 0.6);
}

/* The Game Boy's power LED, glowing. */
.nav[data-game="blog"] .menu a::before {
	width: 8px;
	height: 8px;
	font-size: inherit;
	clip-path: none;
	border-radius: 50%;
	box-shadow: 0 0 6px var(--accent);
}

/* Pac-Man chomps instead of pointing. */
.nav[data-game="now"] .menu a::before {
	width: 0.75em;
	clip-path: none;
	border-radius: 50%;
	background: conic-gradient(
		var(--accent) 0 60deg,
		transparent 60deg 120deg,
		var(--accent) 120deg
	);
}

.start,
.pause {
	display: none;
}

.start {
	padding: 0.7rem 1.1rem;
	font: inherit;
	font-family: var(--font-display);
	font-size: 12px;
	color: var(--pause-fg);
	background: var(--pause-bg);
	border: 2px solid var(--fg);
	border-radius: 999px;
	cursor: pointer;

	&:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	&:active {
		translate: 0 2px;
	}
}

.pause[open] {
	display: block;
	width: min(420px, 100vw - 2rem);
	padding: 2.5rem 2rem 2rem;
	border: 4px solid var(--pause-fg);
	outline: 4px solid var(--pause-bg);
	background: var(--pause-bg);
	color: var(--pause-fg);
	text-align: center;

	&::backdrop {
		background: rgb(0 0 0 / 0.6);
		backdrop-filter: grayscale(1);
	}

	.menu {
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.menu a {
		--fg: var(--pause-fg);
		--accent: var(--pause-accent);
	}
}

.pause-title {
	margin: 0 0 2rem;
	font-family: var(--font-display);
	font-size: 16px;
	color: var(--pause-title);
}

.menu-close {
	font: inherit;
	font-family: var(--font-display);
	font-size: 12px;
	min-height: 44px;
	padding: 0 12px;
	color: inherit;
	opacity: 0.6;
	background: none;
	border: 0;
	cursor: pointer;

	&:focus-visible {
		opacity: 1;
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
}

@media (max-width: 760px) {
	.nav {
		top: 1rem;
		right: 1rem;
	}

	.nav > .menu {
		display: none;
	}

	.start {
		display: block;
	}
}
</style>

<script>
import { initNav } from "../lib/nav";

let cleanup: (() => void) | undefined;

document.addEventListener("astro:page-load", () => {
	cleanup?.();
	cleanup = initNav(document);
});
</script>
