---
import me from "../../data/me";

interface Props {
	inverted?: boolean;
	page?: "projects" | "resume" | "now" | "uses";
}

const links = Astro.props.page
	? [
			{ name: "home", url: "/", label: "home" },
			...me.links.filter(({ name }) => name !== Astro.props.page),
		]
	: me.links;

const { inverted, page } = Astro.props;
const bg = page === "resume" ? "bg-resume" : inverted ? "bg-flat" : "bg-home";
---

<nav class={inverted ? "nav inverted" : "nav"}>
	<button
		type="button"
		class="hamburger"
		id="hamburger"
		aria-label="Toggle menu"
		aria-expanded="false"
	></button>
	<ul class={`links ${bg}`} id="nav-links">
		{links.map((link) => (
			<li class={link.name}>
				<a
					href={link.url}
					{...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
				>
					<span class="caption">{link.label}</span>
				</a>
			</li>
		))}
	</ul>
</nav>

<style is:global>
.no-scroll {
	overflow: hidden;
}
</style>
<style>
.nav {
	position: fixed;
	right: 0;
	top: 0;
	left: 0;
	text-align: center;
	padding: 1rem;
	z-index: 10;
}
.hamburger {
	display: block;
	position: fixed;
	top: 1rem;
	right: 1rem;
	z-index: 20;
	background: none;
	border: none;
	cursor: pointer;
	background-image: url(/images/links/menu.png);
	height: 3rem;
	width: 3rem;
	background-size: cover;
}
.inverted .hamburger {
	filter: invert(1);
}
.hamburger.active {
	background-image: url(/images/links/x.png);
}

.links {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	transform: translateX(100%);
	transition: transform 0.3s ease-in-out;
	margin: 0;
	padding: 0;
	list-style: none;
}

.links.active {
	transform: translateX(0);
}
.links.bg-home {
	background-color: var(--gradient-home-color);
	background-image: var(--gradient-home);
}
.links.bg-resume {
	background-color: var(--gradient-resume-color);
	background-image: var(--gradient-resume);
}
.links.bg-flat {
	background-color: var(--bg);
}

.links li {
	margin: 1rem 0;
}

.links a {
	display: flex;
	flex-direction: column;
	align-items: center;
	text-decoration: none;
	color: #000;
}
.inverted .links a {
	color: var(--white);
}

.links a::before {
	content: "";
	display: block;
	height: 32px;
	width: 32px;
	background-size: contain;
	margin-bottom: 0.5rem;
}
.inverted .links a::before {
	filter: invert(1);
}

.caption {
	display: block;
}

.now a::before {
	background-image: url(/images/links/lightbulb.png);
}
.uses a::before {
	background-image: url(/images/links/wrench.png);
}
.home a::before {
	background-image: url(/images/links/house.png);
}
.blog a::before {
	background-image: url(/images/links/blog.png);
}
.resume a::before {
	background-image: url(/images/links/resume.png);
}
.projects a::before {
	background-image: url(/images/links/rocket.png);
}
.github a::before {
	background-image: url(/images/links/github.png);
}
.linkedIn a::before {
	background-image: url(/images/links/linkedin.png);
}
.mail a::before {
	background-image: url(/images/links/mail.png);
}

@media (min-width: 651px) {
	.nav {
		left: auto;
		text-align: right;
		position: absolute;
	}
	.hamburger {
		display: none;
	}
	.inverted .links,
	.links {
		position: static;
		transform: none;
		flex-direction: row;
		background: none;
	}
	.links li {
		display: inline-block;
		margin: 0;
		margin-right: 0.75rem;
		padding: 0;
	}
	.links li:last-child {
		margin-right: 0;
	}
	.caption {
		display: none;
	}
	.links li:hover .caption {
		display: block;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		top: 4rem;
		text-align: center;
	}
}
</style>

<script>
document.addEventListener("astro:page-load", () => {
	const hamburger = document.getElementById("hamburger");
	const navLinks = document.getElementById("nav-links");
	const mobileQuery = window.matchMedia("(max-width: 650px)");
	const syncInert = () => {
		const isOpen = navLinks.classList.contains("active");
		navLinks.toggleAttribute("inert", mobileQuery.matches && !isOpen);
	};
	syncInert();
	mobileQuery.addEventListener("change", syncInert);
	hamburger?.addEventListener("click", () => {
		const isOpen = navLinks.classList.toggle("active");
		hamburger.classList.toggle("active");
		hamburger.setAttribute("aria-expanded", isOpen.toString());
		document.body.classList.toggle("no-scroll");
		syncInert();
	});
	navLinks?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", () => {
			navLinks.classList.remove("active");
			hamburger.classList.remove("active");
			hamburger.setAttribute("aria-expanded", "false");
			document.body.classList.remove("no-scroll");
			syncInert();
		});
	});
});
</script>
