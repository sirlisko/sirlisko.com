---
import type { Link } from "../../data/me";
import me from "../../data/me";
import { navLinks, type PageName } from "../lib/links";

interface Props {
	page?: PageName;
}

const { page } = Astro.props;

const links = navLinks(me.links, page);
const game = page ?? "home";
const PAUSE_TITLES: Record<typeof game, string> = {
	home: "Paused",
	now: "Ready!",
	projects: "Select",
	uses: "Where to?",
	resume: "Short rest",
	credits: "The end",
};
const attrs = (link: Link) =>
	link.reload ? { "data-astro-reload": true } : {};
---

<nav class="nav" data-game={game} aria-label="Main">
	<ul class="menu">
		{links.map((link) => (
			<li>
				<a
					href={link.url}
					aria-current={link.name === page ? "page" : undefined}
					{...attrs(link)}>{link.label}</a
				>
			</li>
		))}
	</ul>
	<button type="button" class="start" id="nav-start" aria-haspopup="dialog">
		Start
	</button>
	<dialog class="pause" id="nav-pause" aria-label="Menu">
		<p class="pause-title" aria-hidden="true">{PAUSE_TITLES[game]}</p>
		<ul class="menu">
			{links.map((link) => (
				<li>
				<a
					href={link.url}
					aria-current={link.name === page ? "page" : undefined}
					autofocus={link.name === page}
					{...attrs(link)}>{link.label}</a
				>
			</li>
			))}
		</ul>
		<form method="dialog">
			<button type="submit" class="menu-close">Continue</button>
		</form>
	</dialog>
</nav>

<style>
/* Each page is a different game, so the menu borrows its colours and cursor. */
.nav {
	--fg: #000;
	--accent: #000;
	--pause-bg: #000;
	--pause-fg: #fff;
	--pause-title: #f8d878;
	--pause-accent: #f8d878;
	--cursor: "▶";
	--font: var(--font-display);
	--size: 16px;
	position: absolute;
	top: 1.5rem;
	right: 1.5rem;
	z-index: 10;
	font-family: var(--font);
	/* Pages set their own line-height, so pin it to keep the Start button the same size everywhere, blog included. */
	line-height: 1.7;
}

@media (prefers-color-scheme: dark) {
	.nav[data-game="home"] {
		--fg: #e6f6fb;
		--accent: rgb(var(--lamp));
	}
}

.nav[data-game="now"] {
	--fg: #dedeff;
	--accent: #ffe737;
	--pause-title: #ffe737;
	--pause-accent: #ffe737;
}

.nav[data-game="projects"] {
	--fg: #fcfcfc;
	--accent: #f83800;
	--pause-accent: #f83800;
}

.nav[data-game="uses"] {
	--fg: #eff0eb;
	--accent: #5af78e;
	--pause-bg: #282a36;
	--pause-fg: #eff0eb;
	--pause-title: #f3f99d;
	--pause-accent: #5af78e;
	--cursor: ">";
}

.nav[data-game="resume"] {
	--fg: #fff;
	--accent: #ffd166;
	--pause-bg: #fff;
	--pause-fg: #111;
	--pause-title: #8f1d1d;
	--pause-accent: #8f1d1d;
	--cursor: "✦";
}

.nav[data-game="credits"] {
	--fg: #fcfcfc;
	--accent: #f8d878;
}

.menu {
	display: flex;
	gap: 2.25rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.menu a {
	position: relative;
	color: var(--fg);
	font-size: var(--size);
	text-decoration: none;

	&::before {
		content: var(--cursor);
		position: absolute;
		right: calc(100% + 0.5em);
		color: var(--accent);
		font-size: 0.75em;
		line-height: inherit;
		top: 50%;
		translate: 0 -50%;
		visibility: hidden;
	}

	&[aria-current]::before {
		visibility: visible;
	}

	&:hover::before,
	&:focus-visible::before {
		visibility: visible;

		@media (prefers-reduced-motion: no-preference) {
			animation: blink 0.8s steps(1) infinite;
		}
	}

	&:focus-visible {
		outline: none;
		color: var(--accent);
	}
}

/* One cursor at a time: the parked one steps aside while another link is picked. */
.menu:is(:hover, :has(:focus-visible))
a[aria-current]:not(:hover, :focus-visible)::before {
	visibility: hidden;
}

/* Pac-Man chomps instead of pointing. */
.nav[data-game="now"] .menu a::before {
	content: "";
	width: 0.75em;
	height: 0.75em;
	border-radius: 50%;
	background: conic-gradient(
		var(--accent) 0 60deg,
		transparent 60deg 120deg,
		var(--accent) 120deg
	);
}

.start,
.pause {
	display: none;
}

.start {
	padding: 0.7rem 1.1rem;
	font: inherit;
	font-family: var(--font-display);
	font-size: 12px;
	color: var(--pause-fg);
	background: var(--pause-bg);
	border: 2px solid var(--fg);
	border-radius: 999px;
	cursor: pointer;

	&:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	&:active {
		translate: 0 2px;
	}
}

.pause[open] {
	display: block;
	width: min(420px, 100vw - 2rem);
	padding: 2.5rem 2rem 2rem;
	border: 4px solid var(--pause-fg);
	outline: 4px solid var(--pause-bg);
	background: var(--pause-bg);
	color: var(--pause-fg);
	text-align: center;

	&::backdrop {
		background: rgb(0 0 0 / 0.6);
		backdrop-filter: grayscale(1);
	}

	.menu {
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.menu a {
		--fg: var(--pause-fg);
		--accent: var(--pause-accent);
	}
}

.pause-title {
	margin: 0 0 2rem;
	font-family: var(--font-display);
	font-size: 16px;
	color: var(--pause-title);
}

.menu-close {
	font: inherit;
	font-family: var(--font-display);
	font-size: 12px;
	min-height: 44px;
	padding: 0 12px;
	color: inherit;
	opacity: 0.6;
	background: none;
	border: 0;
	cursor: pointer;

	&:focus-visible {
		opacity: 1;
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
}

@media (max-width: 760px) {
	.nav {
		top: 1rem;
		right: 1rem;
	}

	.nav > .menu {
		display: none;
	}

	.start {
		display: block;
	}
}
</style>

<script>
import { initNav } from "../lib/nav";

let cleanup: (() => void) | undefined;

document.addEventListener("astro:page-load", () => {
	cleanup?.();
	cleanup = initNav(document);
});
</script>
