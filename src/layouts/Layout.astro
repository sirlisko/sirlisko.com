---
import pressStart2p from "@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url";
import "@fontsource/press-start-2p/latin-400.css";
import "../styles/tokens.css";
import "../styles/shared.css";
import "../styles/doc.css";
import { ClientRouter } from "astro:transitions";
import { ANALYTICS, AUTHOR, SITE, SITE_URL } from "../config";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: AUTHOR.name,
	alternateName: AUTHOR.alternateName,
	url: SITE_URL,
	image: SITE.image,
	sameAs: AUTHOR.profiles,
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
	.toString()
	.replace(/\/+$/, "");

const analyticsOrigin = new URL(ANALYTICS.src).origin;

interface Props {
	title?: string;
	description?: string;
	image?: string;
	keywords?: string[];
	imageAlt?: string;
	ogType?: "website" | "profile";
	noindex?: boolean;
	/** "doc" is the dark article shell shared by /uses and /projects. */
	theme?: "dark" | "doc";
	/** Only for pages that paint their own dark background without a theme. */
	colorScheme?: "dark" | "light";
}

const {
	title,
	description,
	image,
	imageAlt,
	keywords,
	ogType,
	noindex,
	theme,
	colorScheme = theme ? "dark" : "light",
} = Astro.props;

const metaDescription = description || SITE.description;
const formattedTitle = title ? `${title} | ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<meta name="theme-color" content="#2eaed5">
		<meta name="color-scheme" content={colorScheme}>
		<link rel="manifest" href="/manifest.json">
		<link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
		<link rel="canonical" href={canonicalURL}>
		<link
			rel="preload"
			href={pressStart2p}
			as="font"
			type="font/woff2"
			crossorigin
		>
		<title>{formattedTitle}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="description" content={metaDescription}>
		<meta property="og:title" content={formattedTitle}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:image" content={image || SITE.image}>
		{!image && (  <>    <meta property="og:image:width" content={String(SITE.imageWidth)} />    <meta property="og:image:height" content={String(SITE.imageHeight)} />  </>)}
		<meta property="og:image:alt" content={imageAlt || SITE.imageAlt}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:site_name" content={SITE.title}>
		<meta property="og:type" content={ogType || "website"}>
		{ogType === "profile" && (  <>    <meta property="profile:first_name" content={AUTHOR.firstName} />    <meta property="profile:last_name" content={AUTHOR.lastName} />    <meta property="profile:username" content={AUTHOR.username} />  </>)}
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={formattedTitle}>
		<meta name="twitter:description" content={metaDescription}>
		<meta name="twitter:image" content={image || SITE.image}>
		<meta name="twitter:image:alt" content={imageAlt || SITE.imageAlt}>
		{keywords && keywords.length > 0 ? (    <meta name="keywords" content={keywords.join(`, `)} />  ) : null}
		<link type="text/plain" rel="author" href={`${SITE_URL}/humans.txt`}>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<link rel="preconnect" href={analyticsOrigin}>
		<ClientRouter />
		<script
			is:inline
			defer
			src={ANALYTICS.src}
			data-website-id={ANALYTICS.websiteId}
			data-auto-track="false"
			data-domains={ANALYTICS.domains}
		></script>
		<script is:inline>
		document.addEventListener("astro:page-load", () => {
			void window.umami?.track((props) => ({
				...props,
				title: document.title,
				url:
					window.location.pathname +
					window.location.search +
					window.location.hash,
			}));
		});
		</script>
	</head>
	<body class:list={[theme]}>
		<slot />
	</body>
</html>

<style is:global>
* {
	box-sizing: border-box;
}

body {
	font-family: var(--font-display);
	font-size: 16px;
	margin: 0;
}
</style>
